---
import Social from "./Social.astro";
import type { Player } from "../../types";

interface Props {
  player: Player;
}
const { player } = Astro.props;
---

<div class="member">
  <div class="avatar">
    {player.avatar ? (
      <img src={player.avatar} alt={player.name} />
    ) : (
      <span class="initial">{player.name[0]}</span>
    )}
  </div>
  <div class="meta">
    <div class="name">{player.name}</div>
    <div class="socials">
      {player.twitch && <Social platform="twitch" url={`https://twitch.tv/${player.twitch}`} label={player.twitch} />}
      {player.youtube && <Social platform="youtube" url={`https://youtube.com/${player.youtube}`} label={player.youtube} />}
      {player.geoguessr && <Social platform="geoguessr" url={player.geoguessr} label="GeoGuessr" />}
    </div>
  </div>
</div>

<style>
  .member { display: flex; align-items: center; gap: 14px; }
  .avatar {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: var(--bg-2);
    border: 1.5px solid var(--border-hi);
    display: grid; place-items: center;
    flex-shrink: 0;
    overflow: hidden;
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .initial {
    font-family: var(--serif);
    font-style: italic;
    font-size: 28px;
    color: var(--fg-0);
    line-height: 1;
  }
  .meta { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .name {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--fg-0);
    letter-spacing: -0.01em;
  }
  .socials { display: flex; gap: 6px; flex-wrap: wrap; }
</style>
