---
interface Props {
  eyebrow?: string;
  meta?: string;
  tone?: "loss";
}
const { eyebrow, meta, tone } = Astro.props;
---

<div class="card-head">
  {eyebrow && <span class:list={["eyebrow", tone && `tone-${tone}`]}>{eyebrow}</span>}
  {meta && <span class="meta">{meta}</span>}
  <slot />
</div>

<style>
  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .eyebrow {
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-1);
  }
  .tone-loss { color: var(--loss); }
  .meta {
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--fg-3);
  }
</style>
