---
interface Props {
  variant?: "default" | "warn";
  class?: string;
}
const { variant = "default", class: className } = Astro.props;
---

<div class:list={["card", `variant-${variant}`, className]}>
  <slot />
</div>

<style>
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--pad);
    position: relative;
  }
  .variant-warn {
    background: linear-gradient(180deg, oklch(0.24 0.040 50), var(--card));
    border-color: var(--loss);
  }
</style>
