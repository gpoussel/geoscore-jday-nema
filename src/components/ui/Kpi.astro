---
import HelpTooltip from "./HelpTooltip.astro";

interface Props {
  label: string;
  value: string | number;
  unit?: string;
  tone?: "win" | "loss";
  help?: string[];
}
const { label, value, unit, tone, help } = Astro.props;
---

<div class:list={["kpi", tone && `tone-${tone}`]}>
  <div class="label">
    <span>{label}</span>
    {help && <HelpTooltip lines={help} align="right" />}
  </div>
  <div class="value">
    {value}
    {unit && <span class="unit">{unit}</span>}
  </div>
</div>

<style>
  .kpi {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--pad);
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    overflow: visible;
    z-index: 1;
  }
  .kpi:hover,
  .kpi:focus-within {
    z-index: 20;
  }
  .label {
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .value {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(44px, 5.5vw, 76px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--fg-0);
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .unit {
    font-family: var(--mono);
    font-style: normal;
    font-size: 12px;
    color: var(--fg-2);
    letter-spacing: 0.08em;
  }
  .tone-win .value { color: var(--win); }
  .tone-loss .value { color: var(--loss); }
</style>
