---
interface Props {
  label: string;
  value: string | number;
  unit?: string;
  tone?: "win" | "loss";
  big?: boolean;
}
const { label, value, unit, tone, big } = Astro.props;
---

<div class:list={["kpi", { big }, tone && `tone-${tone}`]}>
  <div class="label">{label}</div>
  <div class="value">
    {value}
    {unit && <span class="unit">{unit}</span>}
  </div>
</div>

<style>
  .kpi {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--pad);
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    overflow: hidden;
  }
  .big { background: linear-gradient(180deg, var(--card-hi), var(--card)); }
  .label {
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-2);
  }
  .value {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(40px, 4.5vw, 64px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--fg-0);
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .unit {
    font-family: var(--mono);
    font-style: normal;
    font-size: 12px;
    color: var(--fg-2);
    letter-spacing: 0.08em;
  }
  .tone-win .value { color: var(--win); }
  .tone-loss .value { color: var(--loss); }
</style>
