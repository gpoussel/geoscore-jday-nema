---
import HelpTooltip from "./HelpTooltip.astro";

interface Props {
  title: string;
  emphasis?: string;
  help?: string[];
}
const { title, emphasis, help } = Astro.props;
---

<div class="block-head">
  <h2 class="block-title">
    {title}
    {emphasis && <> <em>&amp; {emphasis}</em></>}
    {help && <HelpTooltip lines={help} />}
  </h2>
  <slot />
</div>

<style>
  .block-head {
    display: flex;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: var(--gap);
  }
  .block-title {
    font-family: var(--serif);
    font-size: clamp(32px, 3.8vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 400;
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    column-gap: 18px;
    row-gap: 8px;
    flex-wrap: wrap;
  }
  .block-title :global(.help) {
    align-self: center;
  }
  .block-title em { font-style: italic; color: var(--fg-2); }
</style>
