---
interface Props {
  title: string;
  emphasis?: string;
}
const { title, emphasis } = Astro.props;
---

<div class="block-head">
  <h2 class="block-title">
    {title}
    {emphasis && <> <em>&amp; {emphasis}</em></>}
  </h2>
</div>

<style>
  .block-head {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: var(--gap);
  }
  .block-title {
    font-family: var(--serif);
    font-size: clamp(32px, 3.8vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 400;
    flex: 1;
    min-width: 0;
  }
  .block-title em { font-style: italic; color: var(--fg-2); }
</style>
