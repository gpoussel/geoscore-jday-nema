---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const RANK_ICONS: Record<string, string> = {
  "Master 1": `${base}/ranks/master1.webp`,
};

interface Props {
  rank: string;
}
const { rank } = Astro.props;
const icon = RANK_ICONS[rank];
---

<div class="rank" title={rank}>
  {icon ? (
    <img class="icon" src={icon} alt={rank} />
  ) : (
    <span class="text">{rank}</span>
  )}
  <span class="tooltip">{rank}</span>
</div>

<style>
  .rank {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    white-space: nowrap;
  }
  .icon {
    width: 72px; height: 72px;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 2px 8px oklch(0 0 0 / 0.25));
  }
  .text {
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-0);
  }
  .tooltip {
    position: absolute;
    left: 50%;
    top: calc(100% + 6px);
    transform: translateX(-50%);
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-0);
    background: var(--bg-2);
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: 6px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms ease;
  }
  .rank:hover .tooltip { opacity: 1; }
</style>
