---
import TeamMember from "./ui/TeamMember.astro";
import RankBadge from "./ui/RankBadge.astro";
import type { Player } from "../types";

interface Props {
  players: Record<string, Player>;
  duoRank: string;
}
const { players, duoRank } = Astro.props;
const list = Object.values(players);
---

<div class="team-card">
  <div class="left">
    <div class="kicker">Road to Champion</div>
    <div class="title-row">
      <div class="names">
        {list.map((p, i) => (
          <>
            {i > 0 && <span class="amp">&amp;</span>}
            <span class="name">{p.name}</span>
          </>
        ))}
      </div>
      <RankBadge rank={duoRank} />
    </div>
  </div>

  <div class="players">
    {list.map((p) => <TeamMember player={p} />)}
  </div>
</div>

<style>
  .team-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: calc(var(--gap) * 1.5);
    align-items: center;
    padding: var(--pad);
    background: linear-gradient(180deg, var(--bg-1), var(--bg-0));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    position: relative;
    overflow: hidden;
  }
  .team-card::before {
    content: ""; position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 10% 50%, oklch(0.85 0.16 172 / 0.10), transparent 55%),
      radial-gradient(ellipse at 90% 50%, oklch(0.85 0.16 172 / 0.05), transparent 55%);
    pointer-events: none;
  }

  .left { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 14px; }
  .kicker {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--win);
    opacity: 0.9;
  }
  .title-row { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .names {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 14px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(40px, 5vw, 68px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--fg-0);
  }
  .amp {
    font-family: var(--serif);
    font-style: italic;
    color: var(--win);
    font-size: 0.85em;
    opacity: 0.85;
  }

  .players {
    position: relative; z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-left: calc(var(--gap) * 1.5);
    border-left: 1px solid var(--border);
  }

  @media (max-width: 980px) {
    .team-card { grid-template-columns: 1fr; }
    .players {
      padding-left: 0;
      border-left: none;
      padding-top: var(--gap);
      border-top: 1px solid var(--border);
      flex-direction: row;
      flex-wrap: wrap;
    }
    .players > :global(.member) { flex: 1 1 200px; }
  }
</style>
