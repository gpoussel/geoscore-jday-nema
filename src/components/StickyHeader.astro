---
import PeriodToggle from "./PeriodToggle.astro";

interface Props {
  periods: {
    key: string;
    label: string;
    short: string;
    view: { kpis: { games: number; winRate: number; eloNet: number; elo: number; avgAcc: number } };
  }[];
  activeKey: string;
}
const { periods, activeKey } = Astro.props;
---

<div class="sticky-header" data-sticky>
  <div class="sticky-inner">
    <span class="brand">Road to Champion</span>
    <PeriodToggle periods={periods} activeKey={activeKey} />
    <div class="sticky-kpis">
      {periods.map(({ key, view: { kpis } }) => (
        <span data-view={key} class="kpi-bundle">
          <span class="kpi-item"><b>{kpis.games}</b><em>P</em></span>
          <span class="kpi-item">
            <b class={kpis.winRate >= 50 ? "tone-win" : "tone-loss"}>{kpis.winRate}%</b>
            <em>WR</em>
          </span>
          <span class="kpi-item">
            <b>{kpis.elo}</b>
            <em>ELO</em>
          </span>
          <span class="kpi-item">
            <b class={kpis.eloNet >= 0 ? "tone-win" : "tone-loss"}>
              {kpis.eloNet >= 0 ? "+" : ""}{kpis.eloNet}
            </b>
            <em>Δ</em>
          </span>
          <span class="kpi-item"><b>{kpis.avgAcc.toFixed(1).replace(".", ",")}%</b><em>PRÉC</em></span>
        </span>
      ))}
    </div>
  </div>
</div>

<script>
  const sticky = document.querySelector<HTMLElement>("[data-sticky]");
  const header = document.querySelector<HTMLElement>(".header");
  if (sticky && header) {
    const io = new IntersectionObserver(
      ([e]) => sticky.classList.toggle("visible", !e.isIntersecting),
      { threshold: 0, rootMargin: "-40px 0px 0px 0px" },
    );
    io.observe(header);
  }
</script>

<style>
  .sticky-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: color-mix(in oklch, var(--bg-0) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transform: translateY(-100%);
    transition: transform 0.2s ease;
    pointer-events: none;
  }
  .sticky-header.visible {
    transform: translateY(0);
    pointer-events: auto;
  }
  .sticky-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 10px var(--pad);
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .brand {
    font-family: var(--serif);
    font-style: italic;
    font-size: 18px;
    color: var(--fg-0);
    white-space: nowrap;
  }
  .sticky-header :global(.period-bar) {
    margin-top: 0;
    flex: 0 0 auto;
  }
  .sticky-header :global(.period-bar .label) {
    display: none;
  }
  .sticky-header :global(.period-bar .long)  { display: none; }
  .sticky-header :global(.period-bar .short) { display: inline; }
  .sticky-kpis {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .kpi-bundle {
    display: inline-flex;
    align-items: center;
    gap: 16px;
  }
  .kpi-item {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .kpi-item b {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 14px;
    color: var(--fg-0);
  }
  .kpi-item em {
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
    font-style: normal;
  }
  .kpi-item b.tone-win { color: var(--win); }
  .kpi-item b.tone-loss { color: var(--loss); }

  @media (max-width: 980px) {
    .brand { display: none; }
    .sticky-inner { gap: 12px; padding: 8px var(--pad); }
    .kpi-item em { display: none; }
    .sticky-kpis { gap: 10px; }
    .kpi-bundle { gap: 10px; }
  }
  @media (max-width: 640px) {
    .sticky-kpis { display: none; }
  }
</style>
