---
import Card from "./ui/Card.astro";
import CardHead from "./ui/CardHead.astro";
import BlockHead from "./ui/BlockHead.astro";
import Flag from "./ui/Flag.astro";
import { WORLD } from "../data/world";
import { countryName } from "../lib/country";
import type { CountryStat } from "../types";

interface Props { countryStats: Record<string, CountryStat>; }
const { countryStats } = Astro.props;

type Entry = [string, CountryStat];
const seenEntries: Entry[] = Object.entries(countryStats).filter(([, s]) => s.seen >= 1);
const maxSeen = seenEntries.reduce((m, [, s]) => Math.max(m, s.seen), 1);

const colorFor = (code: string) => {
  const s = countryStats[code];
  if (!s || s.seen < 1) return "var(--map-unseen)";
  const t = Math.max(0, Math.min(1, (s.acc - 55) / 40));
  if (t < 0.5) {
    const k = t * 2;
    return `color-mix(in oklch, var(--loss) ${(1 - k) * 100}%, var(--map-mid) ${k * 100}%)`;
  }
  const k = (t - 0.5) * 2;
  return `color-mix(in oklch, var(--map-mid) ${(1 - k) * 100}%, var(--win) ${k * 100}%)`;
};

const topByAcc    = [...seenEntries].sort((a, b) => b[1].acc - a[1].acc).slice(0, 10);
const flopByAcc   = [...seenEntries].sort((a, b) => a[1].acc - b[1].acc).slice(0, 10);
const topByScore  = [...seenEntries].sort((a, b) => b[1].score - a[1].score).slice(0, 10);
const flopByScore = [...seenEntries].sort((a, b) => a[1].score - b[1].score).slice(0, 10);
const topBySeen   = [...seenEntries].sort((a, b) => b[1].seen - a[1].seen).slice(0, 40);

const fmtBalance = (n: number) => {
  const r = Math.round(n);
  return `${r >= 0 ? "+" : "−"}${Math.abs(r).toLocaleString("fr-FR")}`;
};

const nameOf = countryName;
---

<section class="block">
  <BlockHead title="Pays">
    <div class="metric-bar">
      <span class="label">Classer par</span>
      <div class="toggle">
        <button class="btn" data-metric="score">Score</button>
        <button class="btn active" data-metric="precision">Précision</button>
        <button class="btn" data-metric="occurrence">Occurrence</button>
      </div>
    </div>
  </BlockHead>
  <Card class="card-map">
      <CardHead eyebrow="Carte" />
      <div
        class="worldmap-wrap"
        data-max-seen={maxSeen}
      >
        <svg viewBox="0 0 1000 500" width="100%" class="worldmap">
          <defs>
            <pattern id="wmgrid" width="20" height="20" patternUnits="userSpaceOnUse">
              <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255,255,255,0.025)" stroke-width="0.5" />
            </pattern>
          </defs>
          <rect x="150" y="90" width="720" height="310" fill="url(#wmgrid)" rx="4" />
          {WORLD.map((country) => {
            const s = countryStats[country.c];
            const seen = s?.seen ?? 0;
            return (
              <rect
                class="country"
                data-code={country.c}
                data-name={country.n}
                data-seen={s?.seen ?? 0}
                data-acc={s?.acc?.toFixed(1) ?? ""}
                data-adv={s?.advAcc?.toFixed(1) ?? ""}
                data-gap={s?.gap?.toFixed(1) ?? ""}
                data-score={s?.score?.toFixed(0) ?? ""}
                x={country.x}
                y={country.y}
                width={country.w}
                height={country.h}
                rx="1.5"
                fill={colorFor(country.c)}
                stroke="rgba(255,255,255,0.1)"
                stroke-width="0.5"
                style={`cursor: ${seen >= 1 ? "pointer" : "default"}`}
              />
            );
          })}
        </svg>

        <div class="wm-legend">
          <span class="wml-label" data-metric-label>Précision moyenne</span>
          <div class="wml-scale">
            <span style="background: var(--loss)"></span>
            <span style="background: color-mix(in oklch, var(--loss) 50%, var(--map-mid))"></span>
            <span style="background: var(--map-mid)"></span>
            <span style="background: color-mix(in oklch, var(--map-mid) 50%, var(--win))"></span>
            <span style="background: var(--win)"></span>
          </div>
          <div class="wml-ticks">
            <span data-tick-lo>55%</span>
            <span data-tick-mid>75%</span>
            <span data-tick-hi>95%</span>
          </div>
          <div class="wml-note">Pays jamais vus non colorés</div>
        </div>

        <div class="wm-tooltip" hidden>
          <div class="wmt-header">
            <span class="wmt-flag fi"></span>
            <div class="wmt-code"></div>
          </div>
          <div class="wmt-name"></div>
          <div class="wmt-rows">
            <div><span>Apparitions</span><b data-field="seen"></b></div>
            <div><span>Duo</span><b class="duo" data-field="acc"></b></div>
            <div><span>Adv.</span><b class="adv" data-field="adv"></b></div>
            <div><span>Écart</span><b data-field="gap"></b></div>
          </div>
        </div>
      </div>
  </Card>

  <div class="tf-row">
    <Card class="card-top">
        <div class="topflop">
          <div class="tf-title">
            <span data-metric="precision">Top 10<span class="tf-sub">meilleurs</span></span>
            <span data-metric="score">Top 10<span class="tf-sub">meilleurs</span></span>
            <span data-metric="occurrence">Top 40</span>
          </div>
          <ol class="tf-list" data-metric="precision">
            {topByAcc.map(([code, s], i) => (
              <li>
                <span class="tf-rank">{i + 1}</span>
                <Flag code={code} class="tf-flag" />
                <span class="tf-name">{nameOf(code)}</span>
                <span class="tf-app">×{s.seen}</span>
                <span class="tf-val tf-win">{s.acc.toFixed(0)}%</span>
              </li>
            ))}
          </ol>
          <ol class="tf-list" data-metric="score">
            {topByScore.map(([code, s], i) => (
              <li>
                <span class="tf-rank">{i + 1}</span>
                <Flag code={code} class="tf-flag" />
                <span class="tf-name">{nameOf(code)}</span>
                <span class="tf-app">×{s.seen}</span>
                <span class="tf-val tf-win">{fmtBalance(s.score)}</span>
              </li>
            ))}
          </ol>
          <ol class="tf-list" data-metric="occurrence">
            {topBySeen.map(([code, s], i) => (
              <li>
                <span class="tf-rank">{i + 1}</span>
                <Flag code={code} class="tf-flag" />
                <span class="tf-name">{nameOf(code)}</span>
                <span class="tf-app">{s.acc.toFixed(0)}%</span>
                <span class="tf-val tf-win">×{s.seen}</span>
              </li>
            ))}
          </ol>
        </div>
      </Card>

      <Card class="card-flop">
        <div class="topflop">
          <div class="tf-title">Flop 10<span class="tf-sub">pires</span></div>
          <ol class="tf-list" data-metric="precision">
            {flopByAcc.map(([code, s], i) => (
              <li>
                <span class="tf-rank">{i + 1}</span>
                <Flag code={code} class="tf-flag" />
                <span class="tf-name">{nameOf(code)}</span>
                <span class="tf-app">×{s.seen}</span>
                <span class="tf-val tf-loss">{s.acc.toFixed(0)}%</span>
              </li>
            ))}
          </ol>
          <ol class="tf-list" data-metric="score">
            {flopByScore.map(([code, s], i) => (
              <li>
                <span class="tf-rank">{i + 1}</span>
                <Flag code={code} class="tf-flag" />
                <span class="tf-name">{nameOf(code)}</span>
                <span class="tf-app">×{s.seen}</span>
                <span class="tf-val tf-loss">{fmtBalance(s.score)}</span>
              </li>
            ))}
          </ol>
        </div>
    </Card>
  </div>
</section>

<script>
  type Metric = "score" | "precision" | "occurrence";

  const LO = { score: -2500, precision: 55 };
  const HI = { score: 2500, precision: 95 };

  const colorForT = (t: number) => {
    t = Math.max(0, Math.min(1, t));
    if (t < 0.5) {
      const k = t * 2;
      return `color-mix(in oklch, var(--loss) ${(1 - k) * 100}%, var(--map-mid) ${k * 100}%)`;
    }
    const k = (t - 0.5) * 2;
    return `color-mix(in oklch, var(--map-mid) ${(1 - k) * 100}%, var(--win) ${k * 100}%)`;
  };

  const recolor = (metric: Metric) => {
    document.querySelectorAll<HTMLElement>(".worldmap-wrap").forEach((wrap) => {
      const maxSeen = Number(wrap.dataset.maxSeen) || 1;
      wrap.querySelectorAll<SVGRectElement>(".country").forEach((rect) => {
        const seen = Number(rect.dataset.seen);
        if (!seen || seen < 1) {
          rect.setAttribute("fill", "var(--map-unseen)");
          return;
        }
        let t: number;
        if (metric === "occurrence") {
          t = maxSeen > 1 ? (seen - 1) / (maxSeen - 1) : 0.5;
        } else {
          const val = metric === "score" ? Number(rect.dataset.score) : Number(rect.dataset.acc);
          const lo = LO[metric];
          const hi = HI[metric];
          t = (val - lo) / (hi - lo);
        }
        rect.setAttribute("fill", colorForT(t));
      });

      const maxSeenLabel = `×${maxSeen}`;
      wrap.querySelectorAll<HTMLElement>("[data-metric-label]").forEach((el) => {
        el.textContent =
          metric === "score" ? "Balance moyenne" :
          metric === "occurrence" ? "Apparitions" :
          "Précision moyenne";
      });
      const lo = wrap.querySelector<HTMLElement>("[data-tick-lo]");
      const mid = wrap.querySelector<HTMLElement>("[data-tick-mid]");
      const hi = wrap.querySelector<HTMLElement>("[data-tick-hi]");
      if (lo && mid && hi) {
        if (metric === "score") {
          lo.textContent = "−2.5k"; mid.textContent = "0"; hi.textContent = "+2.5k";
        } else if (metric === "occurrence") {
          lo.textContent = "1"; mid.textContent = String(Math.round((maxSeen + 1) / 2)); hi.textContent = maxSeenLabel.slice(1);
        } else {
          lo.textContent = "55%"; mid.textContent = "75%"; hi.textContent = "95%";
        }
      }
    });
  };

  const applyMetric = (metric: Metric) => {
    document.body.classList.remove("metric-score", "metric-precision", "metric-occurrence");
    document.body.classList.add(`metric-${metric}`);
    document.querySelectorAll<HTMLButtonElement>(".metric-bar .btn").forEach((b) => {
      b.classList.toggle("active", b.dataset.metric === metric);
    });
    recolor(metric);
  };

  document.body.classList.add("metric-precision");
  recolor("precision");

  document.querySelectorAll<HTMLButtonElement>(".metric-bar .btn").forEach((btn) => {
    btn.addEventListener("click", () => applyMetric(btn.dataset.metric as Metric));
  });

  document.querySelectorAll<SVGRectElement>(".worldmap .country").forEach((rect) => {
    const wrap = rect.closest(".worldmap-wrap");
    const tip = wrap?.querySelector<HTMLDivElement>(".wm-tooltip");
    if (!tip) return;
    rect.addEventListener("mouseenter", () => {
      const d = rect.dataset;
      if (!d.seen || Number(d.seen) < 1) return;
      tip.hidden = false;
      const flagEl = tip.querySelector<HTMLElement>(".wmt-flag")!;
      flagEl.className = `wmt-flag fi fi-${d.code!.toLowerCase()}`;
      tip.querySelector(".wmt-code")!.textContent = d.code!;
      tip.querySelector(".wmt-name")!.textContent = d.name!;
      tip.querySelector('[data-field="seen"]')!.textContent = d.seen!;
      tip.querySelector('[data-field="acc"]')!.textContent = `${d.acc}%`;
      tip.querySelector('[data-field="adv"]')!.textContent = `${d.adv}%`;
      const gap = Number(d.gap);
      tip.querySelector('[data-field="gap"]')!.textContent = `${gap >= 0 ? "+" : ""}${d.gap}`;
      rect.setAttribute("stroke", "white");
      rect.setAttribute("stroke-width", "1.5");
    });
    rect.addEventListener("mouseleave", () => {
      tip.hidden = true;
      rect.setAttribute("stroke", "rgba(255,255,255,0.1)");
      rect.setAttribute("stroke-width", "0.5");
    });
  });
</script>

<style is:global>
  body.metric-precision  .topflop [data-metric]:not([data-metric="precision"]) { display: none; }
  body.metric-score      .topflop [data-metric]:not([data-metric="score"])     { display: none; }
  body.metric-occurrence .topflop [data-metric]:not([data-metric="occurrence"]) { display: none; }
  body.metric-occurrence .card-flop { display: none; }
  body.metric-occurrence .tf-row { grid-template-columns: 1fr; }
  body.metric-occurrence .tf-list[data-metric="occurrence"] {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(10, auto);
    grid-auto-flow: column;
    column-gap: 12px;
    row-gap: 6px;
  }
</style>

<style>
  .block { margin-top: calc(var(--gap) * 2.5); }
  .block :global(.card-map) { margin-bottom: var(--gap); }
  .tf-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }

  .metric-bar {
    display: flex; align-items: center; gap: 12px;
    padding-bottom: 6px;
  }
  .metric-bar .label {
    font-family: var(--sans); font-size: 12px;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-2);
  }
  .metric-bar .toggle {
    display: flex; gap: 4px; padding: 3px;
    background: var(--bg-2); border: 1px solid var(--border);
    border-radius: 99px;
  }
  .metric-bar .btn {
    background: transparent; border: none; color: var(--fg-2);
    padding: 6px 14px;
    font-family: var(--sans); font-size: 13px;
    letter-spacing: 0.02em; text-transform: uppercase;
    cursor: pointer; border-radius: 99px;
    transition: all 0.15s;
  }
  .metric-bar .btn:hover { color: var(--fg-0); }
  .metric-bar .btn.active { background: var(--fg-0); color: var(--bg-0); }

  .worldmap-wrap { position: relative; }
  .worldmap { display: block; }
  .country { transition: stroke 0.15s, fill 0.2s; }

  .wm-legend {
    position: absolute; left: 0; bottom: 0;
    display: flex; flex-direction: column; gap: 4px;
    font-family: var(--mono); font-size: 10px; color: var(--fg-1);
    background: oklch(0.18 0.015 60 / 0.9);
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    backdrop-filter: blur(4px);
  }
  .wml-label { font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-2); }
  .wml-scale { display: grid; grid-template-columns: repeat(5, 24px); gap: 0; border-radius: 3px; overflow: hidden; }
  .wml-scale span { height: 10px; }
  .wml-ticks { display: flex; justify-content: space-between; font-size: 9px; color: var(--fg-2); }
  .wml-note { color: var(--fg-3); font-size: 9px; margin-top: 2px; }

  .wm-tooltip {
    position: absolute; top: 16px; right: 16px;
    background: var(--bg-1);
    border: 1px solid var(--border-hi);
    border-radius: 10px;
    padding: 14px 16px;
    font-family: var(--mono); font-size: 11px;
    min-width: 200px;
    z-index: 2;
  }
  .wmt-header { display: flex; align-items: center; gap: 12px; }
  .wmt-flag { width: 32px; height: 24px; border-radius: 3px; flex-shrink: 0; }
  .wmt-code { font-family: var(--serif); font-style: italic; font-size: 32px; line-height: 1; color: var(--fg-0); }
  .wmt-name { color: var(--fg-1); margin-bottom: 10px; margin-top: 2px; }
  .wmt-rows { display: flex; flex-direction: column; gap: 4px; }
  .wmt-rows > div { display: flex; justify-content: space-between; gap: 12px; }
  .wmt-rows span { color: var(--fg-2); }
  .wmt-rows b { color: var(--fg-0); font-weight: 500; }
  .wmt-rows b.duo { color: var(--win); }
  .wmt-rows b.adv { color: var(--loss); }

  .topflop { display: flex; flex-direction: column; gap: 12px; }
  .tf-title {
    font-family: var(--serif); font-style: italic;
    font-size: 24px; color: var(--fg-0);
    display: flex; align-items: baseline; gap: 10px;
    letter-spacing: -0.01em;
  }
  .tf-title .tf-sub {
    font-family: var(--sans); font-style: normal;
    font-size: 12px; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--fg-2);
    margin-left: 10px;
  }
  .tf-list { list-style: none; display: flex; flex-direction: column; gap: 6px; padding: 0; margin: 0; }
  .tf-list li {
    display: grid;
    grid-template-columns: 18px 24px 1fr auto auto;
    gap: 10px; align-items: center;
    padding: 8px 10px;
    background: var(--bg-2); border-radius: 6px;
    font-family: var(--mono); font-size: 12px;
  }
  .tf-rank { font-family: var(--serif); font-style: italic; font-size: 16px; color: var(--fg-2); }
  .tf-list :global(.tf-flag) {
    width: 24px; height: 18px;
    border-radius: 2px;
    line-height: 1;
  }
  .tf-name { color: var(--fg-1); font-family: var(--sans); font-size: 12px; }
  .tf-app { color: var(--fg-3); font-size: 10px; }
  .tf-val { font-weight: 600; font-size: 13px; }
  .tf-win { color: var(--win); }
  .tf-loss { color: var(--loss); }

  @media (max-width: 1024px) {
    .tf-row { grid-template-columns: 1fr; }
  }
</style>
