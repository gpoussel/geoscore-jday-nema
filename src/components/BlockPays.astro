---
import Card from "./ui/Card.astro";
import CardHead from "./ui/CardHead.astro";
import BlockHead from "./ui/BlockHead.astro";
import Flag from "./ui/Flag.astro";
import { countryName } from "../lib/country";
import type { CountryStat } from "../types";
import { geoNaturalEarth1, geoPath } from "d3-geo";
import { feature } from "topojson-client";
import type { Topology } from "topojson-specification";
import type { Feature, GeoJsonProperties, Geometry } from "geojson";
import worldData from "world-atlas/countries-110m.json";
import countriesLib from "i18n-iso-countries";

const topology = worldData as unknown as Topology;
const features = (
  feature(topology, topology.objects.countries as any) as unknown as {
    features: Feature<Geometry, GeoJsonProperties>[];
  }
).features;

const MAP_W = 1000;
const MAP_H = 500;
const projection = geoNaturalEarth1().fitExtent(
  [[10, 10], [MAP_W - 10, MAP_H - 10]],
  { type: "Sphere" } as any,
);
const toPath = geoPath(projection);

const featureCode = (f: Feature<Geometry, GeoJsonProperties>): string => {
  const id = f.id != null ? String(f.id).padStart(3, "0") : "";
  return id ? countriesLib.numericToAlpha2(id) ?? "" : "";
};

interface Props { countryStats: Record<string, CountryStat>; }
const { countryStats } = Astro.props;

type Entry = [string, CountryStat];
const seenEntries: Entry[] = Object.entries(countryStats).filter(([, s]) => s.seen >= 1);
const maxSeen = seenEntries.reduce((m, [, s]) => Math.max(m, s.seen), 1);

const colorFor = (code: string) => {
  const s = countryStats[code];
  if (!s || s.seen < 1) return "var(--map-unseen)";
  const t = Math.max(0, Math.min(1, (s.acc - 55) / 40));
  if (t < 0.5) {
    const k = t * 2;
    return `color-mix(in oklch, var(--loss) ${(1 - k) * 100}%, var(--map-mid) ${k * 100}%)`;
  }
  const k = (t - 0.5) * 2;
  return `color-mix(in oklch, var(--map-mid) ${(1 - k) * 100}%, var(--win) ${k * 100}%)`;
};

const topByAcc    = [...seenEntries].sort((a, b) => b[1].acc - a[1].acc).slice(0, 10);
const flopByAcc   = [...seenEntries].sort((a, b) => a[1].acc - b[1].acc).slice(0, 10);
const trustedEntries = seenEntries.filter(([, s]) => s.seen > 5);
const topByAccTrusted  = [...trustedEntries].sort((a, b) => b[1].acc - a[1].acc).slice(0, 10);
const flopByAccTrusted = [...trustedEntries].sort((a, b) => a[1].acc - b[1].acc).slice(0, 10);
const topByScore  = [...seenEntries].sort((a, b) => b[1].score - a[1].score).slice(0, 10);
const flopByScore = [...seenEntries].sort((a, b) => a[1].score - b[1].score).slice(0, 10);
const topBySeen   = [...seenEntries].sort((a, b) => b[1].seen - a[1].seen).slice(0, 40);

const fmtBalance = (n: number) => {
  const r = Math.round(n);
  return `${r >= 0 ? "+" : "−"}${Math.abs(r).toLocaleString("fr-FR")}`;
};

const nameOf = countryName;
---

<section class="block">
  <BlockHead title="Pays">
    <div class="metric-bar">
      <span class="label">Classer par</span>
      <div class="toggle">
        <button class="btn" data-metric="score">Score</button>
        <button class="btn active" data-metric="precision">Précision</button>
        <button class="btn" data-metric="occurrence">Occurrence</button>
      </div>
    </div>
  </BlockHead>
  <Card class="card-map">
      <CardHead eyebrow="Carte" />
      <div
        class="worldmap-wrap"
        data-max-seen={maxSeen}
      >
        <svg viewBox={`0 0 ${MAP_W} ${MAP_H}`} width="100%" class="worldmap">
          <defs>
            <pattern id="wmgrid" width="20" height="20" patternUnits="userSpaceOnUse">
              <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255,255,255,0.025)" stroke-width="0.5" />
            </pattern>
          </defs>
          <g class="wm-zoom">
          <rect x="0" y="0" width={MAP_W} height={MAP_H} fill="url(#wmgrid)" />
          {features.map((f) => {
            const code = featureCode(f);
            const d = toPath(f);
            if (!d) return null;
            const s = code ? countryStats[code] : undefined;
            const seen = s?.seen ?? 0;
            return (
              <path
                class="country"
                data-code={code}
                data-name={countryName(code) || (f.properties?.name as string | undefined) || code}
                data-seen={seen}
                data-acc={s?.acc?.toFixed(1) ?? ""}
                data-adv={s?.advAcc?.toFixed(1) ?? ""}
                data-gap={s?.gap?.toFixed(1) ?? ""}
                data-score={s?.score?.toFixed(0) ?? ""}
                d={d}
                fill={colorFor(code)}
                stroke="rgba(255,255,255,0.12)"
                stroke-width="0.5"
                stroke-linejoin="round"
                style={`cursor: ${seen >= 1 ? "pointer" : "default"}`}
              />
            );
          })}
          </g>
        </svg>

        <div class="wm-zoom-ctrl">
          <button type="button" data-zoom="in" aria-label="Zoomer">+</button>
          <button type="button" data-zoom="out" aria-label="Dézoomer">−</button>
          <button type="button" data-zoom="reset" aria-label="Réinitialiser la vue">⟲</button>
        </div>

        <div class="wm-legend">
          <span class="wml-label" data-metric-label>Précision moyenne</span>
          <div class="wml-scale">
            <span style="background: var(--loss)"></span>
            <span style="background: color-mix(in oklch, var(--loss) 50%, var(--map-mid))"></span>
            <span style="background: var(--map-mid)"></span>
            <span style="background: color-mix(in oklch, var(--map-mid) 50%, var(--win))"></span>
            <span style="background: var(--win)"></span>
          </div>
          <div class="wml-ticks">
            <span data-tick-lo>55%</span>
            <span data-tick-mid>75%</span>
            <span data-tick-hi>95%</span>
          </div>
        </div>

        <div class="wm-tooltip" hidden>
          <div class="wmt-header">
            <span class="wmt-flag fi"></span>
            <div class="wmt-name"></div>
          </div>
          <div class="wmt-rows">
            <div><span>Apparitions</span><b data-field="seen"></b></div>
            <div><span>Duo</span><b class="duo" data-field="acc"></b></div>
          </div>
        </div>
      </div>
  </Card>

  <div class="tf-row">
    <Card class="card-top trusted">
        <div class="topflop">
          <div class="tf-title">
            <span data-metric="precision">Top 10<span class="tf-sub">meilleurs</span></span>
            <span data-metric="score">Top 10<span class="tf-sub">meilleurs</span></span>
            <span data-metric="occurrence">Top 40</span>
            <label class="filter-chk" data-filter-chk>
              <input type="checkbox" checked />
              <span>≥ 6 fois seulement</span>
            </label>
          </div>
          <ol class="tf-list" data-metric="precision" data-filter="all">
            {topByAcc.map(([code, s], i) => (
              <li>
                <span class="tf-rank">{i + 1}</span>
                <Flag code={code} class="tf-flag" />
                <span class="tf-name">{nameOf(code)}</span>
                <span class="tf-app">×{s.seen}</span>
                <span class="tf-val tf-win">{s.acc.toFixed(1)}%</span>
              </li>
            ))}
          </ol>
          <ol class="tf-list" data-metric="precision" data-filter="trusted">
            {topByAccTrusted.map(([code, s], i) => (
              <li>
                <span class="tf-rank">{i + 1}</span>
                <Flag code={code} class="tf-flag" />
                <span class="tf-name">{nameOf(code)}</span>
                <span class="tf-app">×{s.seen}</span>
                <span class="tf-val tf-win">{s.acc.toFixed(1)}%</span>
              </li>
            ))}
          </ol>
          <ol class="tf-list" data-metric="score">
            {topByScore.map(([code, s], i) => (
              <li>
                <span class="tf-rank">{i + 1}</span>
                <Flag code={code} class="tf-flag" />
                <span class="tf-name">{nameOf(code)}</span>
                <span class="tf-app">×{s.seen}</span>
                <span class="tf-val tf-win">{fmtBalance(s.score)}</span>
              </li>
            ))}
          </ol>
          <ol class="tf-list" data-metric="occurrence">
            {topBySeen.map(([code, s], i) => (
              <li>
                <span class="tf-rank">{i + 1}</span>
                <Flag code={code} class="tf-flag" />
                <span class="tf-name">{nameOf(code)}</span>
                <span class="tf-app">{s.acc.toFixed(1)}%</span>
                <span class="tf-val tf-win">×{s.seen}</span>
              </li>
            ))}
          </ol>
        </div>
      </Card>

      <Card class="card-flop trusted">
        <div class="topflop">
          <div class="tf-title">
            Flop 10<span class="tf-sub">pires</span>
            <label class="filter-chk" data-filter-chk>
              <input type="checkbox" checked />
              <span>≥ 6 fois seulement</span>
            </label>
          </div>
          <ol class="tf-list" data-metric="precision" data-filter="all">
            {flopByAcc.map(([code, s], i) => (
              <li>
                <span class="tf-rank">{i + 1}</span>
                <Flag code={code} class="tf-flag" />
                <span class="tf-name">{nameOf(code)}</span>
                <span class="tf-app">×{s.seen}</span>
                <span class="tf-val tf-loss">{s.acc.toFixed(1)}%</span>
              </li>
            ))}
          </ol>
          <ol class="tf-list" data-metric="precision" data-filter="trusted">
            {flopByAccTrusted.map(([code, s], i) => (
              <li>
                <span class="tf-rank">{i + 1}</span>
                <Flag code={code} class="tf-flag" />
                <span class="tf-name">{nameOf(code)}</span>
                <span class="tf-app">×{s.seen}</span>
                <span class="tf-val tf-loss">{s.acc.toFixed(1)}%</span>
              </li>
            ))}
          </ol>
          <ol class="tf-list" data-metric="score">
            {flopByScore.map(([code, s], i) => (
              <li>
                <span class="tf-rank">{i + 1}</span>
                <Flag code={code} class="tf-flag" />
                <span class="tf-name">{nameOf(code)}</span>
                <span class="tf-app">×{s.seen}</span>
                <span class="tf-val tf-loss">{fmtBalance(s.score)}</span>
              </li>
            ))}
          </ol>
        </div>
    </Card>
  </div>
</section>

<script>
  type Metric = "score" | "precision" | "occurrence";

  const LO = { score: -2500, precision: 55 };
  const HI = { score: 2500, precision: 95 };

  const colorForT = (t: number) => {
    t = Math.max(0, Math.min(1, t));
    if (t < 0.5) {
      const k = t * 2;
      return `color-mix(in oklch, var(--loss) ${(1 - k) * 100}%, var(--map-mid) ${k * 100}%)`;
    }
    const k = (t - 0.5) * 2;
    return `color-mix(in oklch, var(--map-mid) ${(1 - k) * 100}%, var(--win) ${k * 100}%)`;
  };

  const HEAT_LO = "oklch(0.38 0.07 285)";
  const HEAT_HI = "oklch(0.80 0.22 330)";
  const colorForHeat = (t: number) => {
    t = Math.max(0, Math.min(1, t));
    return `color-mix(in oklch, ${HEAT_LO} ${(1 - t) * 100}%, ${HEAT_HI} ${t * 100}%)`;
  };

  const paletteFor = (metric: Metric) =>
    metric === "occurrence" ? colorForHeat : colorForT;

  const recolor = (metric: Metric) => {
    const color = paletteFor(metric);
    document.querySelectorAll<HTMLElement>(".worldmap-wrap").forEach((wrap) => {
      const maxSeen = Number(wrap.dataset.maxSeen) || 1;
      wrap.querySelectorAll<SVGElement>(".country").forEach((rect) => {
        const seen = Number(rect.dataset.seen);
        if (!seen || seen < 1) {
          rect.setAttribute("fill", "var(--map-unseen)");
          return;
        }
        let t: number;
        if (metric === "occurrence") {
          t = maxSeen > 1 ? (seen - 1) / (maxSeen - 1) : 0.5;
        } else {
          const val = metric === "score" ? Number(rect.dataset.score) : Number(rect.dataset.acc);
          const lo = LO[metric];
          const hi = HI[metric];
          t = (val - lo) / (hi - lo);
        }
        rect.setAttribute("fill", color(t));
      });

      wrap.querySelectorAll<HTMLElement>(".wml-scale span").forEach((span, i, all) => {
        const t = all.length > 1 ? i / (all.length - 1) : 0.5;
        span.style.background = color(t);
      });

      const maxSeenLabel = `×${maxSeen}`;
      wrap.querySelectorAll<HTMLElement>("[data-metric-label]").forEach((el) => {
        el.textContent =
          metric === "score" ? "Balance moyenne" :
          metric === "occurrence" ? "Apparitions" :
          "Précision moyenne";
      });
      const lo = wrap.querySelector<HTMLElement>("[data-tick-lo]");
      const mid = wrap.querySelector<HTMLElement>("[data-tick-mid]");
      const hi = wrap.querySelector<HTMLElement>("[data-tick-hi]");
      if (lo && mid && hi) {
        if (metric === "score") {
          lo.textContent = "−2.5k"; mid.textContent = "0"; hi.textContent = "+2.5k";
        } else if (metric === "occurrence") {
          lo.textContent = "1"; mid.textContent = String(Math.round((maxSeen + 1) / 2)); hi.textContent = maxSeenLabel.slice(1);
        } else {
          lo.textContent = "55%"; mid.textContent = "75%"; hi.textContent = "95%";
        }
      }
    });
  };

  const applyMetric = (metric: Metric) => {
    document.body.classList.remove("metric-score", "metric-precision", "metric-occurrence");
    document.body.classList.add(`metric-${metric}`);
    document.querySelectorAll<HTMLButtonElement>(".metric-bar .btn").forEach((b) => {
      b.classList.toggle("active", b.dataset.metric === metric);
    });
    recolor(metric);
  };

  document.body.classList.add("metric-precision");
  recolor("precision");

  document.querySelectorAll<HTMLButtonElement>(".metric-bar .btn").forEach((btn) => {
    btn.addEventListener("click", () => applyMetric(btn.dataset.metric as Metric));
  });

  document.querySelectorAll<HTMLLabelElement>("[data-filter-chk]").forEach((label) => {
    const input = label.querySelector<HTMLInputElement>("input");
    const card = label.closest<HTMLElement>(".card-top, .card-flop");
    if (!input || !card) return;
    input.addEventListener("change", () => {
      card.classList.toggle("trusted", input.checked);
    });
  });

  document.querySelectorAll<SVGElement>(".worldmap .country").forEach((rect) => {
    const wrap = rect.closest(".worldmap-wrap");
    const tip = wrap?.querySelector<HTMLDivElement>(".wm-tooltip");
    if (!tip) return;
    rect.addEventListener("mouseenter", () => {
      const d = rect.dataset;
      if (!d.seen || Number(d.seen) < 1) return;
      tip.hidden = false;
      const flagEl = tip.querySelector<HTMLElement>(".wmt-flag")!;
      flagEl.className = `wmt-flag fi fi-${d.code!.toLowerCase()}`;
      tip.querySelector(".wmt-name")!.textContent = d.name!;
      tip.querySelector('[data-field="seen"]')!.textContent = d.seen!;
      tip.querySelector('[data-field="acc"]')!.textContent = `${d.acc}%`;
      rect.setAttribute("stroke", "white");
      rect.setAttribute("stroke-width", "1.5");
    });
    rect.addEventListener("mouseleave", () => {
      tip.hidden = true;
      rect.setAttribute("stroke", "rgba(255,255,255,0.1)");
      rect.setAttribute("stroke-width", "0.5");
    });
  });

  const MIN_SCALE = 1, MAX_SCALE = 12, STEP = 1.4;
  document.querySelectorAll<HTMLElement>(".worldmap-wrap").forEach((wrap) => {
    const svg = wrap.querySelector<SVGSVGElement>(".worldmap");
    const g = wrap.querySelector<SVGGElement>(".wm-zoom");
    if (!svg || !g) return;

    const vbW = Number(svg.getAttribute("viewBox")?.split(" ")[2] ?? 1000);
    const vbH = Number(svg.getAttribute("viewBox")?.split(" ")[3] ?? 500);
    let scale = 1, tx = 0, ty = 0;
    let dragging = false, dragMoved = false, lastX = 0, lastY = 0;

    const apply = () => {
      const maxTx = vbW * (scale - 1);
      const maxTy = vbH * (scale - 1);
      tx = Math.min(0, Math.max(-maxTx, tx));
      ty = Math.min(0, Math.max(-maxTy, ty));
      g.setAttribute("transform", `translate(${tx} ${ty}) scale(${scale})`);
      wrap.classList.toggle("zoomed", scale > 1.01);
    };

    const clientToVB = (cx: number, cy: number) => {
      const r = svg.getBoundingClientRect();
      return { x: ((cx - r.left) / r.width) * vbW, y: ((cy - r.top) / r.height) * vbH };
    };

    const zoomAt = (factor: number, cx: number, cy: number) => {
      const next = Math.min(MAX_SCALE, Math.max(MIN_SCALE, scale * factor));
      if (next === scale) return;
      const p = clientToVB(cx, cy);
      tx = p.x - ((p.x - tx) * next) / scale;
      ty = p.y - ((p.y - ty) * next) / scale;
      scale = next;
      apply();
    };

    svg.addEventListener("wheel", (e) => {
      e.preventDefault();
      const factor = e.deltaY < 0 ? STEP : 1 / STEP;
      zoomAt(factor, e.clientX, e.clientY);
    }, { passive: false });

    svg.addEventListener("pointerdown", (e) => {
      dragging = true; dragMoved = false;
      lastX = e.clientX; lastY = e.clientY;
      svg.setPointerCapture(e.pointerId);
    });
    svg.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const dx = e.clientX - lastX, dy = e.clientY - lastY;
      if (Math.abs(dx) + Math.abs(dy) > 2) dragMoved = true;
      lastX = e.clientX; lastY = e.clientY;
      const r = svg.getBoundingClientRect();
      tx += (dx / r.width) * vbW;
      ty += (dy / r.height) * vbH;
      apply();
    });
    const endDrag = (e: PointerEvent) => {
      dragging = false;
      try { svg.releasePointerCapture(e.pointerId); } catch {}
    };
    svg.addEventListener("pointerup", endDrag);
    svg.addEventListener("pointercancel", endDrag);
    svg.addEventListener("click", (e) => {
      if (dragMoved) { e.stopPropagation(); e.preventDefault(); }
    }, true);

    wrap.querySelectorAll<HTMLButtonElement>(".wm-zoom-ctrl [data-zoom]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const r = svg.getBoundingClientRect();
        const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
        const kind = btn.dataset.zoom;
        if (kind === "in") zoomAt(STEP, cx, cy);
        else if (kind === "out") zoomAt(1 / STEP, cx, cy);
        else { scale = 1; tx = 0; ty = 0; apply(); }
      });
    });
  });
</script>

<style is:global>
  body.metric-precision  .topflop [data-metric]:not([data-metric="precision"]) { display: none; }
  body.metric-score      .topflop [data-metric]:not([data-metric="score"])     { display: none; }
  body.metric-occurrence .topflop [data-metric]:not([data-metric="occurrence"]) { display: none; }
  body.metric-occurrence .card-flop { display: none; }
  body.metric-occurrence .tf-row { grid-template-columns: 1fr; }
  body.metric-occurrence .tf-list[data-metric="occurrence"] {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(10, auto);
    grid-auto-flow: column;
    column-gap: 12px;
    row-gap: 6px;
  }

  .card-top:not(.trusted)  .tf-list[data-metric="precision"][data-filter="trusted"] { display: none; }
  .card-top.trusted        .tf-list[data-metric="precision"][data-filter="all"]     { display: none; }
  .card-flop:not(.trusted) .tf-list[data-metric="precision"][data-filter="trusted"] { display: none; }
  .card-flop.trusted       .tf-list[data-metric="precision"][data-filter="all"]     { display: none; }
  body:not(.metric-precision) [data-filter-chk] { display: none; }
</style>

<style>
  .block { margin-top: calc(var(--gap) * 2.5); }
  .block :global(.card-map) { margin-bottom: var(--gap); }
  .tf-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }

  .metric-bar {
    display: flex; align-items: center; gap: 12px;
    padding-bottom: 6px;
  }
  .metric-bar .label {
    font-family: var(--sans); font-size: 12px;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-2);
  }
  .metric-bar .toggle {
    display: flex; gap: 4px; padding: 3px;
    background: var(--bg-2); border: 1px solid var(--border);
    border-radius: 99px;
  }
  .metric-bar .btn {
    background: transparent; border: none; color: var(--fg-2);
    padding: 6px 14px;
    font-family: var(--sans); font-size: 13px;
    letter-spacing: 0.02em; text-transform: uppercase;
    cursor: pointer; border-radius: 99px;
    transition: all 0.15s;
  }
  .metric-bar .btn:hover { color: var(--fg-0); }
  .metric-bar .btn.active { background: var(--fg-0); color: var(--bg-0); }

  .filter-chk {
    display: inline-flex; align-items: center; gap: 8px;
    margin-left: auto;
    font-family: var(--sans); font-style: normal; font-size: 12px;
    letter-spacing: 0.04em; color: var(--fg-2);
    cursor: pointer;
    user-select: none;
  }
  .filter-chk input {
    appearance: none;
    width: 14px; height: 14px;
    border: 1px solid var(--border); border-radius: 3px;
    background: var(--bg-2);
    cursor: pointer;
    position: relative;
    transition: all 0.15s;
  }
  .filter-chk input:checked {
    background: var(--fg-0); border-color: var(--fg-0);
  }
  .filter-chk input:checked::after {
    content: ""; position: absolute;
    left: 3px; top: 0px;
    width: 4px; height: 8px;
    border: solid var(--bg-0);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .filter-chk:hover { color: var(--fg-0); }

  .worldmap-wrap { position: relative; }
  .worldmap { display: block; cursor: grab; touch-action: none; }
  .worldmap:active { cursor: grabbing; }
  .country { transition: stroke 0.15s, fill 0.2s; vector-effect: non-scaling-stroke; }

  .wm-zoom-ctrl {
    position: absolute; bottom: 12px; right: 12px;
    display: flex; flex-direction: column; gap: 4px;
    z-index: 2;
  }
  .wm-zoom-ctrl button {
    width: 28px; height: 28px;
    background: oklch(0.18 0.015 60 / 0.9);
    border: 1px solid var(--border);
    color: var(--fg-1);
    font-family: var(--mono); font-size: 14px;
    border-radius: 6px; cursor: pointer;
    backdrop-filter: blur(4px);
    transition: all 0.15s;
  }
  .wm-zoom-ctrl button:hover { color: var(--fg-0); border-color: var(--border-hi); }

  .wm-legend {
