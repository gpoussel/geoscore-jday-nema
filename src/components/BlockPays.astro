---
import Card from "./ui/Card.astro";
import CardHead from "./ui/CardHead.astro";
import BlockHead from "./ui/BlockHead.astro";
import { WORLD } from "../data/world";
import type { CountryStat } from "../types";

interface Props { countryStats: Record<string, CountryStat>; }
const { countryStats } = Astro.props;

const colorFor = (code: string) => {
  const s = countryStats[code];
  if (!s || s.seen < 2) return "var(--map-unseen)";
  const t = Math.max(0, Math.min(1, (s.acc - 55) / 40));
  if (t < 0.5) {
    const k = t * 2;
    return `color-mix(in oklch, var(--loss) ${(1 - k) * 100}%, var(--map-mid) ${k * 100}%)`;
  }
  const k = (t - 0.5) * 2;
  return `color-mix(in oklch, var(--map-mid) ${(1 - k) * 100}%, var(--win) ${k * 100}%)`;
};

const seenEntries = Object.entries(countryStats).filter(([, s]) => s.seen >= 2);
const topList = [...seenEntries].sort((a, b) => b[1].acc - a[1].acc).slice(0, 5);
const flopList = [...seenEntries].sort((a, b) => a[1].acc - b[1].acc).slice(0, 5);
const beteNoireEntry = [...seenEntries].sort((a, b) => a[1].gap - b[1].gap)[0];
const beteNoire = beteNoireEntry
  ? { code: beteNoireEntry[0], stat: beteNoireEntry[1], name: WORLD.find((c) => c.c === beteNoireEntry[0])?.n }
  : null;
---

<section class="block">
  <BlockHead title="Pays" emphasis="terrain" />
  <div class="grid">
    <Card class="card-map">
      <CardHead eyebrow="Carte" />
      <div class="worldmap-wrap">
        <svg viewBox="0 0 1000 500" width="100%" class="worldmap">
          <defs>
            <pattern id="wmgrid" width="20" height="20" patternUnits="userSpaceOnUse">
              <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255,255,255,0.025)" stroke-width="0.5" />
            </pattern>
          </defs>
          <rect x="150" y="90" width="720" height="310" fill="url(#wmgrid)" rx="4" />
          {WORLD.map((country) => {
            const s = countryStats[country.c];
            const seen = s?.seen ?? 0;
            return (
              <rect
                class="country"
                data-code={country.c}
                data-name={country.n}
                data-seen={s?.seen ?? 0}
                data-acc={s?.acc?.toFixed(1) ?? ""}
                data-adv={s?.advAcc?.toFixed(1) ?? ""}
                data-gap={s?.gap?.toFixed(1) ?? ""}
                x={country.x}
                y={country.y}
                width={country.w}
                height={country.h}
                rx="1.5"
                fill={colorFor(country.c)}
                stroke="rgba(255,255,255,0.1)"
                stroke-width="0.5"
                style={`cursor: ${seen >= 2 ? "pointer" : "default"}`}
              />
            );
          })}
        </svg>

        <div class="wm-legend">
          <span class="wml-label">Précision moyenne</span>
          <div class="wml-scale">
            <span style="background: var(--loss)"></span>
            <span style="background: color-mix(in oklch, var(--loss) 50%, var(--map-mid))"></span>
            <span style="background: var(--map-mid)"></span>
            <span style="background: color-mix(in oklch, var(--map-mid) 50%, var(--win))"></span>
            <span style="background: var(--win)"></span>
          </div>
          <div class="wml-ticks"><span>55%</span><span>75%</span><span>95%</span></div>
          <div class="wml-note">Pays vus &lt; 2× non colorés</div>
        </div>

        <div class="wm-tooltip" hidden>
          <div class="wmt-code"></div>
          <div class="wmt-name"></div>
          <div class="wmt-rows">
            <div><span>Apparitions</span><b data-field="seen"></b></div>
            <div><span>Duo</span><b class="duo" data-field="acc"></b></div>
            <div><span>Adv.</span><b class="adv" data-field="adv"></b></div>
            <div><span>Écart</span><b data-field="gap"></b></div>
          </div>
        </div>
      </div>
    </Card>

    <div class="side">
      <Card class="card-top">
        <div class="topflop">
          <div class="tf-title">Top 5<span class="tf-sub">meilleurs</span></div>
          <ol class="tf-list">
            {topList.map(([code, s], i) => {
              const country = WORLD.find((c) => c.c === code);
              return (
                <li>
                  <span class="tf-rank">{i + 1}</span>
                  <span class="tf-flag">{code}</span>
                  <span class="tf-name">{country?.n || code}</span>
                  <span class="tf-app">×{s.seen}</span>
                  <span class="tf-acc tf-win">{s.acc.toFixed(0)}%</span>
                </li>
              );
            })}
          </ol>
        </div>
      </Card>

      <Card class="card-flop">
        <div class="topflop">
          <div class="tf-title">Flop 5<span class="tf-sub">pires</span></div>
          <ol class="tf-list">
            {flopList.map(([code, s], i) => {
              const country = WORLD.find((c) => c.c === code);
              return (
                <li>
                  <span class="tf-rank">{i + 1}</span>
                  <span class="tf-flag">{code}</span>
                  <span class="tf-name">{country?.n || code}</span>
                  <span class="tf-app">×{s.seen}</span>
                  <span class="tf-acc tf-loss">{s.acc.toFixed(0)}%</span>
                </li>
              );
            })}
          </ol>
        </div>
      </Card>

      {beteNoire && (
        <Card variant="warn" class="card-bn">
          <div class="bete-noire">
            <div class="bn-eyebrow">Bête noire</div>
            <div class="bn-country">
              <div class="bn-code">{beteNoire.code}</div>
              <div class="bn-name">{beteNoire.name}</div>
            </div>
            <div class="bn-gap">
              <div class="bn-gap-val">{beteNoire.stat.gap.toFixed(1)}</div>
              <div class="bn-gap-lbl">écart moyen<br />vs adversaire</div>
            </div>
            <div class="bn-detail">
              <div><span>Duo</span><b>{beteNoire.stat.acc.toFixed(1)}%</b></div>
              <div><span>Adversaire</span><b>{beteNoire.stat.advAcc.toFixed(1)}%</b></div>
              <div><span>Apparitions</span><b>{beteNoire.stat.seen}</b></div>
            </div>
          </div>
        </Card>
      )}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<SVGRectElement>(".worldmap .country").forEach((rect) => {
    const wrap = rect.closest(".worldmap-wrap");
    const tip = wrap?.querySelector<HTMLDivElement>(".wm-tooltip");
    if (!tip) return;
    rect.addEventListener("mouseenter", () => {
      const d = rect.dataset;
      if (!d.seen || Number(d.seen) < 2) return;
      tip.hidden = false;
      tip.querySelector(".wmt-code")!.textContent = d.code!;
      tip.querySelector(".wmt-name")!.textContent = d.name!;
      tip.querySelector('[data-field="seen"]')!.textContent = d.seen!;
      tip.querySelector('[data-field="acc"]')!.textContent = `${d.acc}%`;
      tip.querySelector('[data-field="adv"]')!.textContent = `${d.adv}%`;
      const gap = Number(d.gap);
      tip.querySelector('[data-field="gap"]')!.textContent = `${gap >= 0 ? "+" : ""}${d.gap}`;
      rect.setAttribute("stroke", "white");
      rect.setAttribute("stroke-width", "1.5");
    });
    rect.addEventListener("mouseleave", () => {
      tip.hidden = true;
      rect.setAttribute("stroke", "rgba(255,255,255,0.1)");
      rect.setAttribute("stroke-width", "0.5");
    });
  });
</script>

<style>
  .block { margin-top: calc(var(--gap) * 2.5); }
  .grid {
    display: grid;
    grid-template-columns: 2.2fr 1fr;
    gap: var(--gap);
  }
  .side { display: flex; flex-direction: column; gap: var(--gap); }

  .worldmap-wrap { position: relative; }
  .worldmap { display: block; }
  .country { transition: stroke 0.15s; }

  .wm-legend {
    position: absolute; left: 0; bottom: 0;
    display: flex; flex-direction: column; gap: 4px;
    font-family: var(--mono); font-size: 10px; color: var(--fg-1);
    background: oklch(0.18 0.015 60 / 0.9);
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    backdrop-filter: blur(4px);
  }
  .wml-label { font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-2); }
  .wml-scale { display: grid; grid-template-columns: repeat(5, 24px); gap: 0; border-radius: 3px; overflow: hidden; }
  .wml-scale span { height: 10px; }
  .wml-ticks { display: flex; justify-content: space-between; font-size: 9px; color: var(--fg-2); }
  .wml-note { color: var(--fg-3); font-size: 9px; margin-top: 2px; }

  .wm-tooltip {
    position: absolute; top: 16px; right: 16px;
    background: var(--bg-1);
    border: 1px solid var(--border-hi);
    border-radius: 10px;
    padding: 14px 16px;
    font-family: var(--mono); font-size: 11px;
    min-width: 200px;
    z-index: 2;
  }
  .wmt-code { font-family: var(--serif); font-style: italic; font-size: 32px; line-height: 1; color: var(--fg-0); }
  .wmt-name { color: var(--fg-1); margin-bottom: 10px; margin-top: 2px; }
  .wmt-rows { display: flex; flex-direction: column; gap: 4px; }
  .wmt-rows > div { display: flex; justify-content: space-between; gap: 12px; }
  .wmt-rows span { color: var(--fg-2); }
  .wmt-rows b { color: var(--fg-0); font-weight: 500; }
  .wmt-rows b.duo { color: var(--win); }
  .wmt-rows b.adv { color: var(--loss); }

  .topflop { display: flex; flex-direction: column; gap: 12px; }
  .tf-title {
    font-family: var(--serif); font-style: italic;
    font-size: 24px; color: var(--fg-0);
    display: flex; align-items: baseline; gap: 10px;
    letter-spacing: -0.01em;
  }
  .tf-title .tf-sub {
    font-family: var(--sans); font-style: normal;
    font-size: 12px; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--fg-2);
  }
  .tf-list { list-style: none; display: flex; flex-direction: column; gap: 6px; padding: 0; margin: 0; }
  .tf-list li {
    display: grid;
    grid-template-columns: 18px 34px 1fr auto auto;
    gap: 10px; align-items: center;
    padding: 8px 10px;
    background: var(--bg-2); border-radius: 6px;
    font-family: var(--mono); font-size: 12px;
  }
  .tf-rank { font-family: var(--serif); font-style: italic; font-size: 16px; color: var(--fg-2); }
  .tf-flag {
    font-family: var(--mono); font-weight: 600;
    letter-spacing: 0.08em; color: var(--fg-0);
    background: var(--bg-0); padding: 3px 6px; border-radius: 3px;
    text-align: center; font-size: 10px;
  }
  .tf-name { color: var(--fg-1); font-family: var(--sans); font-size: 12px; }
  .tf-app { color: var(--fg-3); font-size: 10px; }
  .tf-acc { font-weight: 600; font-size: 13px; }
  .tf-win { color: var(--win); }
  .tf-loss { color: var(--loss); }

  .bete-noire { display: flex; flex-direction: column; gap: 12px; }
  .bn-eyebrow {
    font-family: var(--sans); font-size: 12px;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--loss);
  }
  .bn-country { display: flex; align-items: center; gap: 12px; }
  .bn-code {
    font-family: var(--serif); font-style: italic;
    font-size: 44px; color: var(--fg-0); line-height: 0.9;
    letter-spacing: -0.02em;
  }
  .bn-name { font-family: var(--sans); font-size: 14px; color: var(--fg-1); }
  .bn-gap {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 0; border-top: 1px solid var(--border);
  }
  .bn-gap-val {
    font-family: var(--serif); font-style: italic;
    font-size: 52px; line-height: 0.9; color: var(--loss);
    letter-spacing: -0.03em;
  }
  .bn-gap-lbl {
    font-family: var(--sans); font-size: 12px;
    letter-spacing: 0.04em; color: var(--fg-2);
    text-transform: uppercase; line-height: 1.3;
  }
  .bn-detail {
    display: grid; grid-template-columns: 1fr 1fr 1fr;
    gap: 12px;
    padding-top: 12px; border-top: 1px solid var(--border);
  }
  .bn-detail > div { display: flex; flex-direction: column; gap: 2px; }
  .bn-detail span {
    font-family: var(--sans); font-size: 11px;
    letter-spacing: 0.04em; text-transform: uppercase; color: var(--fg-2);
  }
  .bn-detail b { font-family: var(--mono); font-size: 14px; color: var(--fg-0); font-weight: 500; }

  @media (max-width: 1024px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
