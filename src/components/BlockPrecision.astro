---
import Card from "./ui/Card.astro";
import CardHead from "./ui/CardHead.astro";
import BlockHead from "./ui/BlockHead.astro";
import type { Game, Session } from "../types";

interface Props { games: Game[]; sessions: Session[]; aggregateBySession?: boolean; }
const { games, sessions, aggregateBySession = false } = Astro.props;

const fmtDate = (iso: string) => { const [, m, d] = iso.split("-"); return `${d}/${m}`; };
const fmtSessionLabel = (date: string, time: string) => time ? `${date} · ${time}` : date;

type PrecPoint =
  | { kind: "game"; myAcc: number; advAcc: number; gameNum: number }
  | { kind: "session"; myAcc: number; advAcc: number; label: string; games: number };

const precData: PrecPoint[] = aggregateBySession
  ? sessions
      .map((s) => {
        const sg = games.filter((g) => g.session === s.id);
        if (!sg.length) return null;
        return {
          kind: "session" as const,
          myAcc: sg.reduce((acc, g) => acc + g.myAcc, 0) / sg.length,
          advAcc: sg.reduce((acc, g) => acc + g.advAcc, 0) / sg.length,
          label: fmtSessionLabel(fmtDate(s.date), s.time),
          games: sg.length,
        };
      })
      .filter((p): p is Extract<PrecPoint, { kind: "session" }> => p !== null)
  : games.map((g, i) => ({ kind: "game" as const, myAcc: g.myAcc, advAcc: g.advAcc, gameNum: i + 1 }));

const boundaries = aggregateBySession
  ? []
  : sessions
      .map((s) => {
        const idx = games.findIndex((g) => g.session === s.id);
        return idx < 0 ? null : { idx, date: fmtDate(s.date), time: s.time, weekKey: s.weekKey };
      })
      .filter((b): b is { idx: number; date: string; time: string; weekKey: string } => b !== null);

const weekStartIdxs = (() => {
  if (aggregateBySession) {
    const sessionsWithGames = sessions.filter((s) => games.some((g) => g.session === s.id));
    return sessionsWithGames
      .map((s, i) => (i === 0 || s.weekKey !== sessionsWithGames[i - 1].weekKey ? i : -1))
      .filter((i) => i >= 0);
  }
  return boundaries
    .map((b, i) => (i === 0 || b.weekKey !== boundaries[i - 1].weekKey ? b.idx : -1))
    .filter((i) => i >= 0);
})();

const avgMe = games.length ? games.reduce((s, g) => s + g.myAcc, 0) / games.length : 0;
const avgAdv = games.length ? games.reduce((s, g) => s + g.advAcc, 0) / games.length : 0;

const buckets = [0, 0, 0, 0, 0];
games.forEach((g) => g.roundBuckets.forEach((v, i) => { buckets[i] += v; }));
const total = buckets.reduce((a, b) => a + b, 0);
const labels = ["0–3,5k", "3,5–4,2k", "4,2–4,5k", "4,5–4,8k", "4,8–5k"];
const maxBucket = Math.max(1, ...buckets);

const perfects = games.reduce((s, g) => s + g.perfects, 0);
const perfectShare = buckets[4] ? (perfects / buckets[4]) * 100 : 0;
---

<section class="block">
  <BlockHead title="Précision" />
  <div class="grid">
    <Card class="card-prec">
      <CardHead eyebrow="Duo vs Adversaires" />
      <div class="prec-chart">
        <div class="prec-canvas">
          <canvas></canvas>
          <script type="application/json" class="prec-data" is:inline set:html={JSON.stringify(precData)} />
          <script type="application/json" class="session-boundaries" is:inline set:html={JSON.stringify(boundaries)} />
          <script type="application/json" class="week-starts" is:inline set:html={JSON.stringify(weekStartIdxs)} />
        </div>
        <div class="prec-legend">
          <span><i class="sw sw-win"></i> Duo · moy. {avgMe.toFixed(1).replace(".", ",")}%</span>
          <span><i class="sw sw-loss"></i> Adversaires · moy. {avgAdv.toFixed(1).replace(".", ",")}%</span>
        </div>
      </div>
    </Card>

    <Card class="card-histo">
      <CardHead eyebrow="Distribution" />
      <div class="histo">
        <div class="histo-bars">
          {buckets.map((v, i) => {
            const pct = (v / maxBucket) * 100;
            const tone = i < 2 ? "loss" : i < 3 ? "neutral" : "win";
            const isTop = i === 4 && perfects > 0;
            return (
              <div class="histo-col" data-bucket-label={labels[i]} data-bucket-count={v}>
                <div class="histo-bar-wrap">
                  <div class:list={["histo-bar", `tone-${tone}`]} style={`height: ${pct}%`}>
                    {isTop && (
                      <div class="histo-perfect" style={`height: ${perfectShare}%`} data-perfect-count={perfects}>
                        <span class="hp-star">★</span>
                        <span class="hp-num">{perfects}</span>
                      </div>
                    )}
                  </div>
                </div>
                <div class="histo-label">{labels[i]}</div>
                <div class="histo-pct">{total ? Math.round((v / total) * 100) : 0}%</div>
              </div>
            );
          })}
        </div>
        <div class="histo-tooltip" data-histo-tooltip></div>
      </div>
    </Card>
  </div>
</section>

<style>
  .block { margin-top: calc(var(--gap) * 2.5); }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--gap);
  }
  .grid :global(.card-prec),
  .grid :global(.card-histo) { display: flex; flex-direction: column; }

  .prec-chart { display: flex; flex-direction: column; gap: 12px; height: 100%; }
  .prec-canvas { position: relative; flex: 1 1 0; min-height: 220px; }
  .prec-canvas canvas { display: block; }
  .prec-canvas :global(.prec-tooltip) {
    position: absolute;
    pointer-events: none;
    background: var(--bg-1);
    border: 1px solid var(--border-hi);
    border-radius: 8px;
    padding: 10px 12px;
    min-width: 150px;
    opacity: 0;
    transition: opacity 0.12s;
    z-index: 2;
  }
  .prec-canvas :global(.prec-tooltip .ptl) {
    font-family: var(--mono); font-size: 10px; color: var(--fg-2);
    line-height: 1.5;
    display: flex; align-items: center; gap: 6px;
  }
  .prec-canvas :global(.prec-tooltip .ptl b) { color: var(--fg-0); font-weight: 500; margin-left: auto; }
  .prec-canvas :global(.prec-tooltip .pth) {
    font-family: var(--mono); font-size: 10px; color: var(--fg-2);
    letter-spacing: 0.04em; margin-bottom: 4px;
  }
  .prec-legend {
    display: flex; gap: 24px;
    font-family: var(--sans); font-size: 13px; color: var(--fg-1);
  }
  .prec-legend span { display: flex; align-items: center; gap: 8px; }
  .sw { width: 14px; height: 3px; display: inline-block; border-radius: 2px; }
  .sw-win { background: var(--win); }
  .sw-loss { background: var(--loss); }

  .histo { display: flex; flex-direction: column; height: 100%; position: relative; }
  .histo-bars {
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px;
    flex: 1; align-items: end;
  }
  .histo-col { display: flex; flex-direction: column; align-items: center; gap: 6px; height: 100%; }
  .histo-tooltip {
    position: absolute;
    pointer-events: none;
    background: var(--bg-1);
    border: 1px solid var(--border-hi);
    border-radius: 6px;
    padding: 4px 8px;
    font-family: var(--mono); font-size: 12px; font-weight: 600;
    color: var(--fg-0);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.12s;
    z-index: 3;
  }
  .histo-bar-wrap { width: 100%; flex: 1; min-height: 0; display: flex; align-items: flex-end; }
  .histo-bar {
    width: 100%; border-radius: 3px 3px 0 0; min-height: 3px;
    display: flex; flex-direction: column;
    overflow: hidden;
  }
  .tone-win { background: linear-gradient(180deg, var(--win), oklch(0.64 0.12 195)); }
  .tone-loss { background: linear-gradient(180deg, var(--loss), oklch(0.58 0.15 50)); }
  .tone-neutral { background: var(--map-mid); }
  .histo-perfect {
    align-self: stretch;
    min-height: 22px;
    background: linear-gradient(180deg, oklch(0.92 0.17 95), oklch(0.78 0.18 65));
    display: flex; align-items: center; justify-content: center; gap: 4px;
    color: oklch(0.18 0.03 50);
  }
  .hp-star { font-size: 11px; line-height: 1; }
  .hp-num { font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: 0.02em; }
  .histo-label { font-family: var(--sans); font-size: 12px; color: var(--fg-2); letter-spacing: 0.02em; }
  .histo-pct { font-family: var(--serif); font-style: italic; font-size: 16px; color: var(--fg-0); }

  @media (max-width: 1024px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import {
    Chart,
    LineController,
    LineElement,
    PointElement,
    LinearScale,
    CategoryScale,
    Tooltip,
  } from "chart.js";

  Chart.register(LineController, LineElement, PointElement, LinearScale, CategoryScale, Tooltip);

  type Pt =
    | { kind: "game"; myAcc: number; advAcc: number; gameNum: number }
    | { kind: "session"; myAcc: number; advAcc: number; label: string; games: number };

  const cssVar = (n: string) => getComputedStyle(document.body).getPropertyValue(n).trim();
  const winColor = cssVar("--win");
  const lossColor = cssVar("--loss");
  const accent = cssVar("--accent");
  const sessionLabel = (b: { date: string; time: string }) => b.time ? `${b.date} · ${b.time}` : b.date;

  function ensureTooltipEl(container: HTMLElement) {
    let el = container.querySelector<HTMLDivElement>(".prec-tooltip");
    if (!el) {
      el = document.createElement("div");
      el.className = "prec-tooltip";
      container.appendChild(el);
    }
    return el;
  }

  function makeExternalTooltip(points: Pt[]) {
    return (context: any) => {
      const { chart, tooltip } = context;
      const container = chart.canvas.parentNode as HTMLElement;
      const el = ensureTooltipEl(container);
      if (tooltip.opacity === 0) {
        el.style.opacity = "0";
        return;
      }
      const idx = tooltip.dataPoints[0].dataIndex as number;
      const g = points[idx];
      const header = g.kind === "session"
        ? `${g.label} · ${g.games} ${g.games > 1 ? "parties" : "partie"}`
        : `Partie #${g.gameNum}`;
      el.innerHTML =
        `<div class="pth">${header}</div>` +
        `<div class="ptl"><span class="sw sw-win"></span> Duo <b>${g.myAcc.toFixed(1).replace(".", ",")}%</b></div>` +
        `<div class="ptl"><span class="sw sw-loss"></span> Adv. <b>${g.advAcc.toFixed(1).replace(".", ",")}%</b></div>`;
      const w = container.clientWidth;
      const x = tooltip.caretX;
      const y = tooltip.caretY;
      el.style.left = (x < w / 2 ? x + 14 : x - el.offsetWidth - 14) + "px";
      el.style.top = Math.max(8, y - 50) + "px";
      el.style.opacity = "1";
    };
  }

  const charts: { chart: any }[] = [];

  document.querySelectorAll<HTMLElement>(".prec-canvas").forEach((el) => {
    const dataEl = el.querySelector<HTMLScriptElement>(".prec-data");
    const boundariesEl = el.querySelector<HTMLScriptElement>(".session-boundaries");
    const canvas = el.querySelector<HTMLCanvasElement>("canvas");
    if (!dataEl || !canvas || !dataEl.textContent) return;
    const data = JSON.parse(dataEl.textContent) as Pt[];
    if (!data.length) return;
    const boundaries = boundariesEl?.textContent
      ? (JSON.parse(boundariesEl.textContent) as { idx: number; date: string; time: string; weekKey: string }[])
      : [];
    const weekStartsEl = el.querySelector<HTMLScriptElement>(".week-starts");
    const weekStarts = weekStartsEl?.textContent
      ? (JSON.parse(weekStartsEl.textContent) as number[])
      : [];
    const allAcc = data.flatMap((d) => [d.myAcc, d.advAcc]);
    const minP = Math.max(0, Math.floor(Math.min(...allAcc) / 5) * 5);
    const maxP = Math.min(100, Math.ceil(Math.max(...allAcc) / 5) * 5);

    const sessionMarkersPlugin = {
      id: "sessionMarkers",
      afterEvent(chart: any, args: any) {
        const e = args.event;
        if (!e || !boundaries.length) return;
        const prev = chart.$sessionHovered ?? -1;
        let next = -1;
        if (e.type === "mousemove" || e.type === "touchmove") {
          const { chartArea, scales } = chart;
          if (e.x >= chartArea.left && e.x <= chartArea.right &&
              e.y >= chartArea.top && e.y <= chartArea.bottom) {
            const val = scales.x.getValueForPixel(e.x);
            if (val != null && Number.isFinite(val)) {
              for (let i = boundaries.length - 1; i >= 0; i--) {
                if (val >= boundaries[i].idx) { next = i; break; }
              }
            }
          }
        }
        if (next !== prev) {
          chart.$sessionHovered = next;
          args.changed = true;
        }
      },
      beforeDatasetsDraw(chart: any) {
        const { ctx, chartArea, scales } = chart;
        ctx.save();
        if (weekStarts.length) {
          const STRIP_W = 80;
          const STRIP_H = 4;
          for (const idx of weekStarts) {
            const x = scales.x.getPixelForValue(idx);
            const w = Math.min(STRIP_W, chartArea.right - x);
            if (w <= 0) continue;
            const grad = ctx.createLinearGradient(x, 0, x + w, 0);
            grad.addColorStop(0, `color-mix(in oklch, ${accent} 45%, transparent)`);
            grad.addColorStop(1, `color-mix(in oklch, ${accent} 0%, transparent)`);
            ctx.fillStyle = grad;
            ctx.fillRect(x, chartArea.top, w, STRIP_H);
          }
        }
        if (!boundaries.length) { ctx.restore(); return; }
        ctx.font = '500 9px "JetBrains Mono", monospace';
        ctx.textAlign = "left";
        const xs = boundaries.map((b: any) => scales.x.getPixelForValue(b.idx));
        const widths = boundaries.map((b: any) => ctx.measureText(sessionLabel(b)).width);
        let crowded = false;
        for (let i = 0; i < boundaries.length - 1; i++) {
          if (xs[i] + widths[i] + 8 > xs[i + 1]) { crowded = true; break; }
        }
        ctx.setLineDash([3, 3]);
        ctx.strokeStyle = "rgba(255,255,255,0.12)";
        ctx.lineWidth = 1;
        for (const x of xs) {
          ctx.beginPath();
          ctx.moveTo(x, chartArea.top);
          ctx.lineTo(x, chartArea.bottom);
          ctx.stroke();
        }
        ctx.setLineDash([]);
        const drawLabel = (i: number, alpha: number) => {
          const b = boundaries[i];
          const tx = xs[i] + 4 + widths[i] > chartArea.right ? xs[i] - 4 - widths[i] : xs[i] + 4;
          ctx.fillStyle = `rgba(255,255,255,${alpha})`;
          ctx.fillText(sessionLabel(b), tx, chartArea.top - 4);
        };
        const hovered = chart.$sessionHovered ?? -1;
        if (crowded) {
          if (hovered >= 0) drawLabel(hovered, 0.85);
        } else {
          for (let i = 0; i < boundaries.length; i++) drawLabel(i, 0.55);
        }
        ctx.restore();
      },
    };

    const chart = new Chart(canvas.getContext("2d")!, {
      type: "line",
      plugins: [sessionMarkersPlugin],
      data: {
        labels: data.map((_, i) => String(i + 1)),
        datasets: [
          {
            label: "Duo",
            data: data.map((d) => d.myAcc),
            borderColor: winColor,
            borderWidth: 2.5,
            tension: 0,
            pointRadius: 2.5,
            pointHoverRadius: 5,
            pointBackgroundColor: winColor,
            pointBorderColor: "transparent",
            fill: false,
          },
          {
            label: "Adv.",
            data: data.map((d) => d.advAcc),
            borderColor: lossColor,
            borderWidth: 2,
            borderDash: [4, 3],
            tension: 0,
            pointRadius: 0,
            pointHoverRadius: 5,
            pointBackgroundColor: lossColor,
            pointBorderColor: "transparent",
            fill: false,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        layout: { padding: { top: 16 } },
        interaction: { intersect: false, mode: "index" },
        scales: {
          x: { display: false },
          y: {
            min: minP,
            max: maxP,
            grid: { color: "rgba(255,255,255,0.04)" },
            border: { display: false },
            ticks: {
              color: "rgba(255,255,255,0.3)",
              font: { family: "JetBrains Mono, monospace", size: 9 },
              stepSize: 10,
              padding: 6,
              callback: (v) => `${v}%`,
            },
          },
        },
        plugins: {
          legend: { display: false },
          tooltip: { enabled: false, external: makeExternalTooltip(data) },
        },
      },
    });

    charts.push({ chart });
  });

  document.querySelectorAll<HTMLButtonElement>(".period-bar .btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      requestAnimationFrame(() => charts.forEach(({ chart }) => chart.resize()));
    });
  });

  document.querySelectorAll<HTMLElement>(".histo").forEach((root) => {
    const tip = root.querySelector<HTMLDivElement>("[data-histo-tooltip]");
    if (!tip) return;
    const cols = root.querySelectorAll<HTMLElement>(".histo-col");
    cols.forEach((col) => {
      col.addEventListener("mousemove", (e) => {
        const rect = root.getBoundingClientRect();
        const perfect = (e.target as HTMLElement).closest<HTMLElement>("[data-perfect-count]");
        tip.textContent = perfect ? perfect.dataset.perfectCount! : col.dataset.bucketCount!;
        const x = e.clientX - rect.left + 12;
        const y = e.clientY - rect.top + 12;
        const maxX = rect.width - tip.offsetWidth - 4;
        tip.style.left = Math.min(x, maxX) + "px";
        tip.style.top = y + "px";
        tip.style.opacity = "1";
      });
      col.addEventListener("mouseleave", () => { tip.style.opacity = "0"; });
    });
  });
</script>
