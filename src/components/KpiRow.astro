---
import Kpi from "./ui/Kpi.astro";

interface Props {
  games: number;
  winRate: number;
  eloNet: number;
  avgAcc: number;
}
const { games, winRate, eloNet, avgAcc } = Astro.props;
const noGames = games === 0;
---

<div class="kpi-row">
  <Kpi
    label="Parties jouées"
    value={games}
    help={["Nombre de parties de duel incluses dans la période active."]}
  />
  <Kpi
    label="Win-rate"
    value={noGames ? "—" : `${winRate}%`}
    tone={noGames ? undefined : winRate >= 50 ? "win" : "loss"}
    help={["Parties gagnées / parties jouées sur la période active.", "Le résultat est arrondi au pourcentage entier."]}
  />
  <Kpi
    label="ELO net"
    value={`${eloNet >= 0 ? "+" : ""}${eloNet}`}
    tone={eloNet >= 0 ? "win" : "loss"}
    help={["Somme des variations d'ELO de toutes les parties de la période active."]}
  />
  <Kpi
    label="Précision moy."
    value={noGames ? "—" : `${avgAcc.toFixed(1).replace(".", ",")}%`}
    help={["Moyenne des précisions du duo par partie.", "La précision d'une partie est la moyenne des scores du duo divisés par 50."]}
  />
</div>

<style>
  .kpi-row {
    margin-top: var(--gap);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap);
  }
  @media (max-width: 1024px) {
    .kpi-row { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .kpi-row { grid-template-columns: 1fr; }
  }
</style>
