---
// Celebratory confetti burst shown once per tab session when the duo is
// Champion. Pure vanilla canvas, no dependency, no framework.
---

<canvas class="confetti-canvas" aria-hidden="true"></canvas>

<style>
  .confetti-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
  }
</style>

<script>
  type Particle = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    color: string;
    rot: number;
    vrot: number;
    flip: number;
    vflip: number;
    sway: number;
    swayPhase: number;
  };

  const canvas = document.querySelector<HTMLCanvasElement>(".confetti-canvas");
  const ctx = canvas?.getContext("2d") ?? null;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!canvas || !ctx || reduce) {
    canvas?.remove();
  } else {
    run(canvas, ctx);
  }

  function run(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D) {
    // Champion palette: sky, blue, pale sky, white, pastel mint, gold.
    const colors = ["#38bdf8", "#2563eb", "#7dd3fc", "#ffffff", "#a7f3d0", "#fcd34d"];
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    let W = 0;
    let H = 0;
    const resize = () => {
      W = window.innerWidth;
      H = window.innerHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener("resize", resize);

    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const TAU = Math.PI * 2;

    // Two side cannons popping inward from ~2/3 of the page height.
    const makeBurst = (originX: number, dirSign: number): Particle[] => {
      const originY = H * 0.66;
      const n = Math.min(140, Math.max(60, Math.round(W / 12)));
      return Array.from({ length: n }, () => {
        const angle = rand(0.12, 1.3); // above horizontal, toward the centre
        const speed = rand(12, 27);
        return {
          x: originX,
          y: originY,
          vx: dirSign * Math.cos(angle) * speed,
          vy: -Math.sin(angle) * speed,
          size: rand(5, 11),
          color: colors[(Math.random() * colors.length) | 0],
          rot: rand(0, TAU),
          vrot: rand(-0.2, 0.2),
          flip: rand(0, TAU),
          vflip: rand(0.05, 0.18),
          sway: rand(0.01, 0.04),
          swayPhase: rand(0, TAU),
        };
      });
    };

    const particles: Particle[] = [...makeBurst(0, 1), ...makeBurst(W, -1)];

    // Low gravity + strong drag → quick spread, then a slow flutter down
    // that keeps confetti on screen for ~10s.
    const gravity = 0.13;
    const drag = 0.95;
    const fadeFrom = 9000;
    const duration = 10500;
    const start = performance.now();

    const frame = (now: number) => {
      const elapsed = now - start;
      const alpha = elapsed < fadeFrom ? 1 : Math.max(0, 1 - (elapsed - fadeFrom) / (duration - fadeFrom));
      ctx.clearRect(0, 0, W, H);
      ctx.globalAlpha = alpha;

      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.vy = (p.vy + gravity) * drag;
        p.vx *= drag;
        p.swayPhase += p.sway;
        p.x += p.vx + Math.sin(p.swayPhase) * 0.8;
        p.y += p.vy;
        p.rot += p.vrot;
        p.flip += p.vflip;

        if (p.y > H + 20 || p.x < -40 || p.x > W + 40) {
          particles.splice(i, 1);
          continue;
        }

        const w = p.size;
        const h = p.size * 0.45 * Math.abs(Math.cos(p.flip));
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.fillStyle = p.color;
        ctx.fillRect(-w / 2, -h / 2, w, h);
        ctx.restore();
      }

      if (elapsed < duration && particles.length > 0) {
        requestAnimationFrame(frame);
      } else {
        window.removeEventListener("resize", resize);
        canvas.remove();
      }
    };
    requestAnimationFrame(frame);
  }
</script>
