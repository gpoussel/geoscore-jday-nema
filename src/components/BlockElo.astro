---
import Card from "./ui/Card.astro";
import CardHead from "./ui/CardHead.astro";
import BlockHead from "./ui/BlockHead.astro";
import type { Game, Session } from "../types";

interface Props { games: Game[]; sessions: Session[]; }
const { games, sessions } = Astro.props;

const fmtDate = (iso: string) => { const [, m, d] = iso.split("-"); return `${d}/${m}`; };
const boundaries = sessions
  .map((s) => {
    const idx = games.findIndex((g) => g.session === s.id);
    return idx < 0 ? null : { idx, date: fmtDate(s.date), time: s.time, week: s.week };
  })
  .filter((b): b is { idx: number; date: string; time: string; week: number } => b !== null);

const elos = games.map((g) => g.elo);
const highIdx = games.length ? elos.indexOf(Math.max(...elos)) : -1;
const lowIdx = games.length ? elos.indexOf(Math.min(...elos)) : -1;

const eloData = games.map((g) => ({
  elo: g.elo,
  eloDelta: g.eloDelta,
  won: g.won,
  rounds: g.rounds,
  myAcc: g.myAcc,
}));

const wins = games.filter((g) => g.won).length;
const losses = games.length - wins;
const winPct = games.length ? (wins / games.length) * 100 : 0;

const R = 70;
const C = 2 * Math.PI * R;

const categories = [
  { label: "V. écrasantes", count: games.filter((g) => g.won && g.margin === "crush").length, tone: "win", weight: "strong" },
  { label: "V. propres",    count: games.filter((g) => g.won && g.margin === "clean").length, tone: "win", weight: "med" },
  { label: "V. serrées",    count: games.filter((g) => g.won && g.margin === "tight").length, tone: "win", weight: "light" },
  { label: "D. serrées",    count: games.filter((g) => !g.won && g.margin === "tight").length, tone: "loss", weight: "light" },
  { label: "D. propres",    count: games.filter((g) => !g.won && g.margin === "clean").length, tone: "loss", weight: "med" },
  { label: "D. larges",     count: games.filter((g) => !g.won && g.margin === "crush").length, tone: "loss", weight: "strong" },
];
const maxC = Math.max(1, ...categories.map((c) => c.count));
---

<section class="block">
  <BlockHead title="ELO" emphasis="résultats" />
  <div class="grid">
    <Card class="card-elo">
      <CardHead eyebrow="Évolution" />
      <div class="elo-chart" data-high-idx={highIdx} data-low-idx={lowIdx}>
        <canvas></canvas>
        <script type="application/json" class="elo-data" is:inline set:html={JSON.stringify(eloData)} />
        <script type="application/json" class="session-boundaries" is:inline set:html={JSON.stringify(boundaries)} />
      </div>
    </Card>

    <Card class="card-donut">
      <CardHead eyebrow="Bilan" />
      <div class="donut-block">
        <div class="donut-wrap">
          <div class="donut-tip donut-tip-win"><span class="dot win"></span> Victoires <b>{wins}</b></div>
          <div class="donut-tip donut-tip-loss"><span class="dot loss"></span> Défaites <b>{losses}</b></div>
          <svg viewBox="0 0 200 200" width="180" height="180">
            <circle class="arc arc-loss" cx="100" cy="100" r={R} fill="none" stroke="var(--loss)" stroke-width="22" />
            <circle class="arc arc-win" cx="100" cy="100" r={R} fill="none" stroke="var(--win)" stroke-width="22" stroke-dasharray={`${(winPct / 100) * C} ${C}`} transform="rotate(-90 100 100)" />
            <text x="100" y="96" text-anchor="middle" font-family="var(--serif)" font-size="36" fill="white" font-style="italic">
              {Math.round(winPct)}<tspan font-size="20">%</tspan>
            </text>
            <text x="100" y="115" text-anchor="middle" font-family="var(--sans)" font-size="10" fill="rgba(255,255,255,0.5)" letter-spacing="2">WIN-RATE</text>
          </svg>
        </div>
      </div>
    </Card>

    <Card class="card-margin">
      <CardHead eyebrow="Marges" />
      <div class="margin-bars">
        {categories.map((c) => (
          <div class="mb-row">
            <div class="mb-label">{c.label}</div>
            <div class="mb-track">
              <div class:list={["mb-fill", `tone-${c.tone}`, `w-${c.weight}`]} style={`width: ${(c.count / maxC) * 100}%`}>
                <span class="mb-count">{c.count}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </Card>
  </div>
</section>

<style>
  .block { margin-top: calc(var(--gap) * 2.5); }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto auto;
    gap: var(--gap);
  }
  .grid :global(.card-elo)    { grid-column: 1; grid-row: 1 / 3; display: flex; flex-direction: column; }
  .grid :global(.card-donut)  { grid-column: 2; grid-row: 1; }
  .grid :global(.card-margin) { grid-column: 2; grid-row: 2; }

  .elo-chart { position: relative; flex: 1 1 0; min-height: 260px; }
  .elo-chart canvas { display: block; }
  .elo-chart :global(.elo-tooltip) {
    position: absolute;
    pointer-events: none;
    background: var(--bg-1);
    border: 1px solid var(--border-hi);
    border-radius: 8px;
    padding: 10px 12px;
    min-width: 140px;
    opacity: 0;
    transition: opacity 0.12s;
    z-index: 2;
  }
  .elo-chart :global(.elo-tooltip .etl) {
    font-family: var(--mono); font-size: 10px; color: var(--fg-2);
    line-height: 1.5;
  }
  .elo-chart :global(.elo-tooltip .etl b) { color: var(--fg-0); font-weight: 500; }
  .elo-chart :global(.elo-tooltip .ett) {
    font-family: var(--serif); font-style: italic; font-size: 13px;
    margin: 2px 0 4px;
  }

  .donut-block { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .donut-wrap { position: relative; display: grid; place-items: center; }
  .donut-wrap .arc { cursor: default; }
  .donut-tip {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    display: flex; align-items: center; gap: 8px;
    font-family: var(--mono); font-size: 12px; color: var(--fg-1);
    padding: 6px 12px;
    background: var(--bg-1);
    border: 1px solid var(--border-hi);
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s;
    z-index: 2;
  }
  .donut-tip b { color: var(--fg-0); font-weight: 500; font-size: 13px; }
  .donut-wrap:has(.arc-win:hover) .donut-tip-win { opacity: 1; }
  .donut-wrap:has(.arc-loss:hover) .donut-tip-loss { opacity: 1; }
  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .dot.win { background: var(--win); }
  .dot.loss { background: var(--loss); }
  .margin-bars { display: flex; flex-direction: column; gap: 10px; }
  .mb-row { display: grid; grid-template-columns: 130px 1fr; align-items: center; gap: 12px; }
  .mb-label {
    font-family: var(--sans); font-size: 12px; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--fg-1);
  }
  .mb-track { height: 20px; background: var(--bg-2); border-radius: 4px; overflow: hidden; }
  .mb-fill {
    height: 100%; display: flex; align-items: center; justify-content: flex-end;
    padding: 0 8px; border-radius: 4px;
    transition: width 0.4s;
  }
  .tone-win  { background: var(--win); }
  .tone-loss { background: var(--loss); }
  .w-strong { opacity: 1; }
  .w-med    { opacity: 0.75; }
  .w-light  { opacity: 0.5; }
  .mb-count {
    font-family: var(--mono); font-size: 11px; font-weight: 600;
    color: var(--bg-0);
  }

  @media (max-width: 1024px) {
    .grid { grid-template-columns: 1fr; }
    .grid :global(.card-elo) { grid-column: 1; grid-row: auto; }
    .grid :global(.card-donut),
    .grid :global(.card-margin) { grid-column: 1; grid-row: auto; }
  }
</style>

<script>
  import {
    Chart,
    LineController,
    LineElement,
    PointElement,
    LinearScale,
    CategoryScale,
    Filler,
    Tooltip,
  } from "chart.js";

  Chart.register(LineController, LineElement, PointElement, LinearScale, CategoryScale, Filler, Tooltip);

  type Pt = { elo: number; eloDelta: number; won: boolean; rounds: number; myAcc: number };

  const cssVar = (n: string) => getComputedStyle(document.body).getPropertyValue(n).trim();
  const winColor = cssVar("--win");
  const lossColor = cssVar("--loss");
  const accent = cssVar("--accent");

  const highLowPlugin = {
    id: "highLow",
    afterDatasetsDraw(chart: any, _args: any, opts: any) {
      const { ctx } = chart;
      const meta = chart.getDatasetMeta(0);
      const vals = chart.data.datasets[0].data as number[];
      const draw = (idx: number, label: string, dy: number) => {
        const pt = meta.data[idx];
        if (!pt) return;
        ctx.save();
        ctx.font = '600 10px "JetBrains Mono", monospace';
        ctx.fillStyle = "white";
        ctx.textAlign = "center";
        ctx.fillText(`${label} ${vals[idx]}`, pt.x, pt.y + dy);
        ctx.restore();
      };
      if (opts.highIdx >= 0) draw(opts.highIdx, "MAX", -12);
      if (opts.lowIdx >= 0) draw(opts.lowIdx, "MIN", 20);
    },
  };

  Chart.register(highLowPlugin);

  function ensureTooltipEl(container: HTMLElement) {
    let el = container.querySelector<HTMLDivElement>(".elo-tooltip");
    if (!el) {
      el = document.createElement("div");
      el.className = "elo-tooltip";
      container.appendChild(el);
    }
    return el;
  }

  function makeExternalTooltip(points: Pt[]) {
    return (context: any) => {
      const { chart, tooltip } = context;
      const container = chart.canvas.parentNode as HTMLElement;
      const el = ensureTooltipEl(container);
      if (tooltip.opacity === 0) {
        el.style.opacity = "0";
        return;
      }
      const idx = tooltip.dataPoints[0].dataIndex as number;
      const g = points[idx];
      const sign = g.eloDelta > 0 ? "+" : "";
      const color = g.won ? winColor : lossColor;
      el.innerHTML =
        `<div class="etl">Partie #${idx + 1}</div>` +
        `<div class="ett" style="color:${color}">${g.won ? "Victoire" : "Défaite"} ${sign}${g.eloDelta}</div>` +
        `<div class="etl">ELO <b>${g.elo}</b></div>` +
        `<div class="etl">Rounds <b>${g.rounds}</b> · Préc. <b>${g.myAcc.toFixed(1).replace(".", ",")}%</b></div>`;
      const w = container.clientWidth;
      const x = tooltip.caretX;
      const y = tooltip.caretY;
      el.style.left = (x < w / 2 ? x + 14 : x - el.offsetWidth - 14) + "px";
      el.style.top = Math.max(8, y - 70) + "px";
      el.style.opacity = "1";
    };
  }

  const charts: { el: HTMLElement; chart: any }[] = [];

  document.querySelectorAll<HTMLElement>(".elo-chart").forEach((el) => {
    const dataEl = el.querySelector<HTMLScriptElement>(".elo-data");
    const boundariesEl = el.querySelector<HTMLScriptElement>(".session-boundaries");
    const canvas = el.querySelector<HTMLCanvasElement>("canvas");
    if (!dataEl || !canvas || !dataEl.textContent) return;
    const data = JSON.parse(dataEl.textContent) as Pt[];
    if (!data.length) return;
    const boundaries = boundariesEl?.textContent
      ? (JSON.parse(boundariesEl.textContent) as { idx: number; date: string; time: string; week: number }[])
      : [];
    const weekStarts = boundaries.filter((b, i) => i === 0 || b.week !== boundaries[i - 1].week);
    const highIdx = Number(el.dataset.highIdx);
    const lowIdx = Number(el.dataset.lowIdx);
    const elos = data.map((d) => d.elo);
    const dense = data.length > 80;
    const basePt = dense ? 2 : 3.5;
    const emphPt = dense ? 3.5 : 5;
    const hoverPt = dense ? 5 : 6;
    const lo = Math.min(...elos);
    const hi = Math.max(...elos);
    const rawStep = (hi - lo) / 4 || 1;
    const niceSteps = [5, 10, 20, 25, 50, 100, 200, 250, 500];
    const step = niceSteps.find((s) => s >= rawStep) ?? 1000;
    const minE = Math.floor(lo / step) * step;
    const maxE = Math.ceil(hi / step) * step;

    const sessionMarkersPlugin = {
      id: "sessionMarkers",
      afterEvent(chart: any, args: any) {
        const e = args.event;
        if (!e || !boundaries.length) return;
        const prev = chart.$sessionHovered ?? -1;
        let next = -1;
        if (e.type === "mousemove" || e.type === "touchmove") {
          const { chartArea, scales } = chart;
          if (e.x >= chartArea.left && e.x <= chartArea.right &&
              e.y >= chartArea.top && e.y <= chartArea.bottom) {
            const val = scales.x.getValueForPixel(e.x);
            if (val != null && Number.isFinite(val)) {
              for (let i = boundaries.length - 1; i >= 0; i--) {
                if (val >= boundaries[i].idx) { next = i; break; }
              }
            }
          }
        }
        if (next !== prev) {
          chart.$sessionHovered = next;
          args.changed = true;
        }
      },
      beforeDatasetsDraw(chart: any) {
        if (!boundaries.length) return;
        const { ctx, chartArea, scales } = chart;
        ctx.save();
        const STRIP_W = 80;
        const STRIP_H = 4;
        for (const b of weekStarts) {
          const x = scales.x.getPixelForValue(b.idx);
          const w = Math.min(STRIP_W, chartArea.right - x);
          if (w <= 0) continue;
          const grad = ctx.createLinearGradient(x, 0, x + w, 0);
          grad.addColorStop(0, `color-mix(in oklch, ${accent} 45%, transparent)`);
          grad.addColorStop(1, `color-mix(in oklch, ${accent} 0%, transparent)`);
          ctx.fillStyle = grad;
          ctx.fillRect(x, chartArea.top, w, STRIP_H);
        }
        ctx.font = '500 9px "JetBrains Mono", monospace';
        ctx.textAlign = "left";
        const xs = boundaries.map((b: any) => scales.x.getPixelForValue(b.idx));
        const widths = boundaries.map((b: any) => ctx.measureText(`${b.date} · ${b.time}`).width);
        let crowded = false;
        for (let i = 0; i < boundaries.length - 1; i++) {
          if (xs[i] + widths[i] + 8 > xs[i + 1]) { crowded = true; break; }
        }
        ctx.setLineDash([3, 3]);
        ctx.strokeStyle = "rgba(255,255,255,0.12)";
        ctx.lineWidth = 1;
        for (const x of xs) {
          ctx.beginPath();
          ctx.moveTo(x, chartArea.top);
          ctx.lineTo(x, chartArea.bottom);
          ctx.stroke();
        }
        ctx.setLineDash([]);
        const drawLabel = (i: number, alpha: number) => {
          const b = boundaries[i];
          const tx = xs[i] + 4 + widths[i] > chartArea.right ? xs[i] - 4 - widths[i] : xs[i] + 4;
          ctx.fillStyle = `rgba(255,255,255,${alpha})`;
          ctx.fillText(`${b.date} · ${b.time}`, tx, chartArea.top - 4);
        };
        const hovered = chart.$sessionHovered ?? -1;
        if (crowded) {
          if (hovered >= 0) drawLabel(hovered, 0.85);
        } else {
          for (let i = 0; i < boundaries.length; i++) drawLabel(i, 0.55);
        }
        ctx.restore();
      },
    };

    const chart = new Chart(canvas.getContext("2d")!, {
      type: "line",
      plugins: [sessionMarkersPlugin],
      data: {
        labels: data.map((_, i) => String(i + 1)),
        datasets: [
          {
            data: elos,
            borderColor: "rgba(255,255,255,0.4)",
            borderWidth: 1.5,
            tension: 0,
            fill: true,
            backgroundColor: (c: any) => {
              const area = c.chart.chartArea;
              if (!area) return "transparent";
              const g = c.chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
              g.addColorStop(0, `color-mix(in oklch, ${accent} 22%, transparent)`);
              g.addColorStop(1, `color-mix(in oklch, ${accent} 0%, transparent)`);
              return g;
            },
            pointRadius: (c: any) => (c.dataIndex === highIdx || c.dataIndex === lowIdx ? emphPt : basePt),
            pointHoverRadius: hoverPt,
            pointBackgroundColor: (c: any) => (data[c.dataIndex].won ? winColor : lossColor),
            pointHoverBackgroundColor: (c: any) => (data[c.dataIndex].won ? winColor : lossColor),
            pointBorderColor: (c: any) => (c.dataIndex === highIdx || c.dataIndex === lowIdx ? "white" : "transparent"),
            pointHoverBorderColor: (c: any) => (c.dataIndex === highIdx || c.dataIndex === lowIdx ? "white" : "transparent"),
            pointBorderWidth: 2,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        layout: { padding: { top: 16 } },
        interaction: { intersect: false, mode: "index" },
        scales: {
          x: { display: false },
          y: {
            min: minE,
            max: maxE,
            grid: { color: "rgba(255,255,255,0.05)" },
            border: { display: false },
            ticks: {
              color: "rgba(255,255,255,0.35)",
              font: { family: "JetBrains Mono, monospace", size: 10 },
              stepSize: step,
              padding: 6,
            },
          },
        },
        plugins: {
          legend: { display: false },
          tooltip: { enabled: false, external: makeExternalTooltip(data) },
          // @ts-expect-error custom plugin options
          highLow: { highIdx, lowIdx },
        },
      },
    });

    charts.push({ el, chart });
  });

  // Inactive view starts at display:none → canvas has 0 size. Re-fit on period toggle.
  document.querySelectorAll<HTMLButtonElement>(".period-bar .btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      requestAnimationFrame(() => charts.forEach(({ chart }) => chart.resize()));
    });
  });
</script>
