---
import Card from "./ui/Card.astro";
import CardHead from "./ui/CardHead.astro";
import BlockHead from "./ui/BlockHead.astro";
import type { Game } from "../types";

interface Props { games: Game[]; }
const { games } = Astro.props;

const W = 720, H = 260, PAD = 32;
const elos = games.map((g) => g.elo);
const minE = games.length ? Math.min(...elos) - 15 : 0;
const maxE = games.length ? Math.max(...elos) + 15 : 1;
const highIdx = games.length ? elos.indexOf(Math.max(...elos)) : -1;
const lowIdx = games.length ? elos.indexOf(Math.min(...elos)) : -1;

const x = (i: number) => PAD + (i / Math.max(1, games.length - 1)) * (W - PAD * 2);
const y = (e: number) => H - PAD - ((e - minE) / (maxE - minE)) * (H - PAD * 2);

const path = games.map((g, i) => (i === 0 ? "M" : "L") + x(i) + "," + y(g.elo)).join(" ");
const area = games.length ? `${path} L ${x(games.length - 1)},${H - PAD} L ${x(0)},${H - PAD} Z` : "";

const grid: { y: number; v: number }[] = [];
for (let i = 0; i <= 4; i++) {
  const v = minE + (maxE - minE) * (i / 4);
  grid.push({ y: y(v), v: Math.round(v) });
}

const wins = games.filter((g) => g.won).length;
const losses = games.length - wins;
const winPct = games.length ? (wins / games.length) * 100 : 0;

const R = 70;
const C = 2 * Math.PI * R;
const shortGames = games.filter((g) => g.rounds <= 7);
const longGames = games.filter((g) => g.rounds > 7);
const shortWR = shortGames.length
  ? Math.round((shortGames.filter((g) => g.won).length / shortGames.length) * 100)
  : 0;
const longWR = longGames.length
  ? Math.round((longGames.filter((g) => g.won).length / longGames.length) * 100)
  : 0;

const categories = [
  { label: "V. écrasantes", count: games.filter((g) => g.won && g.margin === "crush").length, tone: "win", weight: "strong" },
  { label: "V. propres",    count: games.filter((g) => g.won && g.margin === "clean").length, tone: "win", weight: "med" },
  { label: "V. serrées",    count: games.filter((g) => g.won && g.margin === "tight").length, tone: "win", weight: "light" },
  { label: "D. serrées",    count: games.filter((g) => !g.won && g.margin === "tight").length, tone: "loss", weight: "light" },
  { label: "D. propres",    count: games.filter((g) => !g.won && g.margin === "clean").length, tone: "loss", weight: "med" },
  { label: "D. larges",     count: games.filter((g) => !g.won && g.margin === "crush").length, tone: "loss", weight: "strong" },
];
const maxC = Math.max(1, ...categories.map((c) => c.count));
---

<section class="block">
  <BlockHead title="ELO" emphasis="résultats" />
  <div class="grid">
    <Card class="card-elo">
      <CardHead eyebrow="Évolution" />
      <div class="elo-chart">
        <svg viewBox={`0 0 ${W} ${H}`} width="100%">
          <defs>
            <linearGradient id="eloArea" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.22" />
              <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
            </linearGradient>
          </defs>
          {grid.map((g) => (
            <>
              <line x1={PAD} y1={g.y} x2={W - PAD} y2={g.y} stroke="rgba(255,255,255,0.05)" />
              <text x={8} y={g.y + 3} fill="rgba(255,255,255,0.35)" font-size="10" font-family="var(--mono)">{g.v}</text>
            </>
          ))}
          {games.length > 0 && (
            <>
              <path d={area} fill="url(#eloArea)" />
              <path d={path} stroke="rgba(255,255,255,0.4)" stroke-width="1.5" fill="none" />
            </>
          )}
          {games.map((g, i) => {
            const tipX = x(i) < W / 2 ? x(i) + 12 : x(i) - 150;
            const tipY = Math.max(20, y(g.elo) - 80);
            return (
              <g class="point">
                <line class="hover-line" x1={x(i)} y1={PAD} x2={x(i)} y2={H - PAD} stroke="rgba(255,255,255,0.2)" stroke-dasharray="2 3" />
                <circle
                  class="point-circle"
                  cx={x(i)}
                  cy={y(g.elo)}
                  r={3.5}
                  fill={g.won ? "var(--win)" : "var(--loss)"}
                  stroke={i === highIdx || i === lowIdx ? "white" : "transparent"}
                  stroke-width="2"
                />
                {(i === highIdx || i === lowIdx) && (
                  <text
                    x={x(i)}
                    y={y(g.elo) + (i === highIdx ? -14 : 20)}
                    text-anchor="middle"
                    font-size="10"
                    font-family="var(--mono)"
                    fill="white"
                    font-weight="600"
                  >
                    {i === highIdx ? "HIGH " : "LOW "}{g.elo}
                  </text>
                )}
                <g class="tooltip" transform={`translate(${tipX}, ${tipY})`}>
                  <rect width="138" height="76" rx="8" fill="var(--bg-1)" stroke="var(--border-hi)" />
                  <text x="10" y="20" font-size="10" font-family="var(--mono)" fill="var(--fg-2)">Partie #{i + 1}</text>
                  <text x="10" y="40" font-size="13" font-family="var(--serif)" font-style="italic" fill={g.won ? "var(--win)" : "var(--loss)"}>
                    {g.won ? "Victoire" : "Défaite"} {g.eloDelta > 0 ? "+" : ""}{g.eloDelta}
                  </text>
                  <text x="10" y="56" font-size="10" font-family="var(--mono)" fill="var(--fg-2)">
                    ELO <tspan fill="var(--fg-0)">{g.elo}</tspan>
                  </text>
                  <text x="10" y="70" font-size="10" font-family="var(--mono)" fill="var(--fg-2)">
                    Rounds <tspan fill="var(--fg-0)">{g.rounds}</tspan> · Préc. <tspan fill="var(--fg-0)">{g.myAcc}%</tspan>
                  </text>
                </g>
                <rect class="hit" x={x(i) - 10} y={0} width={20} height={H} fill="transparent" />
              </g>
            );
          })}
        </svg>
      </div>
    </Card>

    <Card class="card-donut">
      <CardHead eyebrow="Bilan" />
      <div class="donut-block">
        <div class="donut-wrap">
          <svg viewBox="0 0 200 200" width="180" height="180">
            <circle cx="100" cy="100" r={R} fill="none" stroke="var(--loss)" stroke-width="22" />
            <circle cx="100" cy="100" r={R} fill="none" stroke="var(--win)" stroke-width="22" stroke-dasharray={`${(winPct / 100) * C} ${C}`} transform="rotate(-90 100 100)" />
            <text x="100" y="96" text-anchor="middle" font-family="var(--serif)" font-size="36" fill="white" font-style="italic">
              {Math.round(winPct)}<tspan font-size="20">%</tspan>
            </text>
            <text x="100" y="115" text-anchor="middle" font-family="var(--sans)" font-size="10" fill="rgba(255,255,255,0.5)" letter-spacing="2">WIN-RATE</text>
          </svg>
        </div>
        <div class="donut-legend">
          <div class="dl-row"><span class="dot win"></span> Victoires <b>{wins}</b></div>
          <div class="dl-row"><span class="dot loss"></span> Défaites <b>{losses}</b></div>
          <div class="dl-split">
            <div>
              <div class="dl-lbl">WR courtes (≤7)</div>
              <div class="dl-val"><b>{shortWR}%</b> <span>({shortGames.length})</span></div>
            </div>
            <div>
              <div class="dl-lbl">WR longues (&gt;7)</div>
              <div class="dl-val"><b>{longWR}%</b> <span>({longGames.length})</span></div>
            </div>
          </div>
        </div>
      </div>
    </Card>

    <Card class="card-margin">
      <CardHead eyebrow="Marges" />
      <div class="margin-bars">
        {categories.map((c) => (
          <div class="mb-row">
            <div class="mb-label">{c.label}</div>
            <div class="mb-track">
              <div class:list={["mb-fill", `tone-${c.tone}`, `w-${c.weight}`]} style={`width: ${(c.count / maxC) * 100}%`}>
                <span class="mb-count">{c.count}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </Card>
  </div>
</section>

<style>
  .block { margin-top: calc(var(--gap) * 2.5); }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto auto;
    gap: var(--gap);
  }
  .grid :global(.card-elo)    { grid-column: 1; grid-row: 1 / 3; }
  .grid :global(.card-donut)  { grid-column: 2; grid-row: 1; }
  .grid :global(.card-margin) { grid-column: 2; grid-row: 2; }

  .elo-chart { position: relative; }
  .point .tooltip { opacity: 0; pointer-events: none; transition: opacity 0.12s; }
  .point .hover-line { opacity: 0; transition: opacity 0.12s; }
  .point:hover .tooltip,
  .point:hover .hover-line { opacity: 1; }
  .point:hover .point-circle { r: 6; }
  .point .point-circle { transition: r 0.1s; }

  .donut-block { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .donut-wrap { display: grid; place-items: center; }
  .donut-legend { width: 100%; display: flex; flex-direction: column; gap: 10px; }
  .dl-row {
    display: flex; align-items: center; gap: 10px;
    font-family: var(--mono); font-size: 12px; color: var(--fg-1);
    padding: 6px 10px; background: var(--bg-2); border-radius: 6px;
  }
  .dl-row b { margin-left: auto; font-weight: 500; font-size: 13px; color: var(--fg-0); }
  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .dot.win { background: var(--win); }
  .dot.loss { background: var(--loss); }
  .dl-split { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 4px; }
  .dl-split > div { padding: 10px; background: var(--bg-2); border-radius: 6px; }
  .dl-lbl {
    font-family: var(--sans); font-size: 11px; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--fg-2); margin-bottom: 4px;
  }
  .dl-val {
    font-family: var(--serif); font-style: italic; font-size: 22px;
    color: var(--fg-0); display: flex; align-items: baseline; gap: 6px;
  }
  .dl-val span { font-family: var(--mono); font-style: normal; font-size: 10px; color: var(--fg-2); }

  .margin-bars { display: flex; flex-direction: column; gap: 10px; }
  .mb-row { display: grid; grid-template-columns: 130px 1fr; align-items: center; gap: 12px; }
  .mb-label {
    font-family: var(--sans); font-size: 12px; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--fg-1);
  }
  .mb-track { height: 20px; background: var(--bg-2); border-radius: 4px; overflow: hidden; }
  .mb-fill {
    height: 100%; display: flex; align-items: center; justify-content: flex-end;
    padding: 0 8px; border-radius: 4px;
    transition: width 0.4s;
  }
  .tone-win  { background: var(--win); }
  .tone-loss { background: var(--loss); }
  .w-strong { opacity: 1; }
  .w-med    { opacity: 0.75; }
  .w-light  { opacity: 0.5; }
  .mb-count {
    font-family: var(--mono); font-size: 11px; font-weight: 600;
    color: var(--bg-0);
  }

  @media (max-width: 1024px) {
    .grid { grid-template-columns: 1fr; }
    .grid :global(.card-elo) { grid-column: 1; grid-row: auto; }
    .grid :global(.card-donut),
    .grid :global(.card-margin) { grid-column: 1; grid-row: auto; }
  }
</style>
