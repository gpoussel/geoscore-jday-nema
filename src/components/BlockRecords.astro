---
import BlockHead from "./ui/BlockHead.astro";
import Flag from "./ui/Flag.astro";
import { countryName } from "../lib/country";
import type { Game, Round } from "../types";

interface Props { games: Game[]; rounds: Round[]; }
const { games, rounds } = Astro.props;

const gameIds = new Set(games.map((g) => g.id));
const gameRounds = rounds.filter((r) => gameIds.has(r.gameId));

const bestHit = gameRounds
  .filter((r) => r.winner === "me")
  .reduce((best, r) => (r.damage > best.damage ? r : best), { damage: 0 } as Round);
const worstHit = gameRounds
  .filter((r) => r.winner === "opp")
  .reduce((best, r) => (r.damage > best.damage ? r : best), { damage: 0 } as Round);

let winStreak = 0, lossStreak = 0, curW = 0, curL = 0;
for (const g of games) {
  if (g.won) { curW++; curL = 0; winStreak = Math.max(winStreak, curW); }
  else { curL++; curW = 0; lossStreak = Math.max(lossStreak, curL); }
}

const longest = games.reduce(
  (a, b) => (b.rounds > a.rounds ? b : a),
  { rounds: 0, finalMyMult: 0, finalOppMult: 0 } as Game
);

const fmtMult = (m: number) => `${m}`;

type Tone = "win" | "loss" | "neutral";
const tiles: {
  label: string;
  value: string | number;
  unit?: string;
  country?: string;
  meta: string;
  tone: Tone;
  icon: string;
}[] = [
  {
    label: "Coup parfait",
    value: bestHit.damage ? bestHit.damage.toLocaleString("fr-FR") : "—",
    unit: "HP",
    country: bestHit.country || undefined,
    meta: `mult. ×${bestHit.usedMult ? fmtMult(bestHit.usedMult) : "—"}`,
    tone: "win",
    icon: "⚡",
  },
  {
    label: "Belle saucisse",
    value: worstHit.damage ? `-${worstHit.damage.toLocaleString("fr-FR")}` : "—",
    unit: "HP",
    country: worstHit.country || undefined,
    meta: `adv. ×${worstHit.usedMult ? fmtMult(worstHit.usedMult) : "—"}`,
    tone: "loss",
    icon: "🌭",
  },
  {
    label: "Série de victoires",
    value: winStreak,
    unit: "V",
    meta: "consécutives",
    tone: "win",
    icon: "▲",
  },
  {
    label: "Série de défaites",
    value: lossStreak,
    unit: "D",
    meta: "consécutives",
    tone: "loss",
    icon: "▼",
  },
  {
    label: "Plus longue partie",
    value: longest.rounds || "—",
    unit: "rounds",
    meta: `Duo ×${longest.finalMyMult ? fmtMult(longest.finalMyMult) : "—"} · Adv. ×${longest.finalOppMult ? fmtMult(longest.finalOppMult) : "—"}`,
    tone: "neutral",
    icon: "∞",
  },
];
---

<section class="block">
  <BlockHead title="Records" emphasis="faits d'armes" />
  <div class="grid">
    {tiles.map((t) => (
      <div class:list={["tile", `tone-${t.tone}`]}>
        <div class="icon">{t.icon}</div>
        <div class="label">{t.label}</div>
        <div class="big">
          <span class="val">{t.value}</span>
          {t.unit && <span class="unit">{t.unit}</span>}
        </div>
        <div class="meta">
          {t.country && (
            <span class="meta-country">
              <Flag code={t.country} class="meta-flag" />
              <span>{countryName(t.country)}</span>
            </span>
          )}
          {t.country && " · "}{t.meta}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .block { margin-top: calc(var(--gap) * 2.5); }
  .grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--gap);
  }
  .tile {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--pad);
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
    overflow: hidden;
    min-height: 220px;
  }
  .tile::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(ellipse at top right, transparent 50%, var(--bg-0));
    pointer-events: none;
    opacity: 0.4;
  }
  .tone-win::before  { background: radial-gradient(ellipse at top right, var(--win-soft), transparent 70%); opacity: 1; }
  .tone-loss::before { background: radial-gradient(ellipse at top right, var(--loss-soft), transparent 70%); opacity: 1; }
  .tone-win  { border-color: oklch(0.85 0.16 172 / 0.4); }
  .tone-loss { border-color: oklch(0.68 0.17 50 / 0.4); }

  .icon { font-size: 24px; opacity: 0.7; position: relative; z-index: 1; }
  .label {
    font-family: var(--sans); font-size: 12px;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--fg-1);
    position: relative; z-index: 1;
  }
  .big {
    font-family: var(--serif); font-style: italic;
    font-size: clamp(40px, 4vw, 56px);
    line-height: 0.9; color: var(--fg-0);
    display: flex; align-items: baseline; gap: 6px;
    letter-spacing: -0.03em;
    margin-top: auto;
    position: relative; z-index: 1;
  }
  .tone-win .val  { color: var(--win); }
  .tone-loss .val { color: var(--loss); }
  .unit {
    font-family: var(--mono); font-style: normal;
    font-size: 11px; color: var(--fg-2);
    letter-spacing: 0.10em;
  }
  .meta {
    font-family: var(--sans); font-size: 12px;
    color: var(--fg-2);
    position: relative; z-index: 1;
    letter-spacing: 0.02em;
    display: flex; align-items: center; flex-wrap: wrap; gap: 4px;
  }
  .meta-country { display: inline-flex; align-items: center; gap: 6px; color: var(--fg-1); }
  .meta :global(.meta-flag) { width: 16px; height: 12px; border-radius: 2px; }

  @media (max-width: 1024px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
