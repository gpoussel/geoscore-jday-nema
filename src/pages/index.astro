---
import "../styles/global.css";
import statsData from "../data/stats.json";
import playersData from "../data/players.json";
import type { CountryStat, Game, PlayersFile, Round, Stats } from "../types";
import TeamCard from "../components/TeamCard.astro";
import PeriodToggle from "../components/PeriodToggle.astro";
import StickyHeader from "../components/StickyHeader.astro";
import KpiRow from "../components/KpiRow.astro";
import BlockElo from "../components/BlockElo.astro";
import BlockPrecision from "../components/BlockPrecision.astro";
import BlockPays from "../components/BlockPays.astro";
import BlockRecords from "../components/BlockRecords.astro";
import BlockSessions from "../components/BlockSessions.astro";

const stats = statsData as Stats;
const { duoRank, players } = playersData as PlayersFile;

const logPrecision = (s: number) =>
  Math.max(0, Math.log2(Math.max(1, s) / 2500) * 100);

const roundsByGame: Record<string, Round[]> = {};
for (const r of stats.rounds) (roundsByGame[r.gameId] ??= []).push(r);

const enrichedGames: Game[] = stats.games.map((g) => {
  const rs = roundsByGame[g.id] ?? [];
  const myAcc = rs.length ? rs.reduce((s, r) => s + logPrecision(r.myScore), 0) / rs.length : 0;
  const advAcc = rs.length ? rs.reduce((s, r) => s + logPrecision(r.oppScore), 0) / rs.length : 0;
  return { ...g, myAcc, advAcc };
});

type View = {
  games: Game[];
  rounds: Round[];
  sessions: Stats["sessions"];
  countryStats: Record<string, CountryStat>;
  kpis: { games: number; winRate: number; eloNet: number; avgAcc: number };
};

const buildView = (games: Game[], sessions: Stats["sessions"]): View => {
  const gids = new Set(games.map((g) => g.id));
  const rounds = stats.rounds.filter((r) => gids.has(r.gameId));

  const agg: Record<string, { seen: number; mySum: number; advSum: number; balSum: number }> = {};
  for (const r of rounds) {
    const k = r.country;
    if (!agg[k]) agg[k] = { seen: 0, mySum: 0, advSum: 0, balSum: 0 };
    agg[k].seen++;
    agg[k].mySum += logPrecision(r.myScore);
    agg[k].advSum += logPrecision(r.oppScore);
    agg[k].balSum += r.myScore - r.oppScore;
  }
  const countryStats: Record<string, CountryStat> = {};
  for (const k in agg) {
    const a = agg[k];
    const acc = a.mySum / a.seen;
    const advAcc = a.advSum / a.seen;
    const score = a.balSum / a.seen;
    countryStats[k] = { seen: a.seen, acc, advAcc, gap: acc - advAcc, score };
  }

  const wins = games.filter((g) => g.won).length;
  const eloNet = games.reduce((s, g) => s + g.eloDelta, 0);
  const avgAcc = games.length ? games.reduce((s, g) => s + g.myAcc, 0) / games.length : 0;

  return {
    games,
    rounds,
    sessions,
    countryStats,
    kpis: {
      games: games.length,
      winRate: Math.round((wins / Math.max(1, games.length)) * 100),
      eloNet,
      avgAcc,
    },
  };
};

const weeks = [...new Set(enrichedGames.map((g) => g.week))].sort((a, b) => a - b);
const latestWeek = weeks.length ? weeks[weeks.length - 1] : 0;

type ViewKey = string; // "w15", "w16", …, "all"
const periods: { key: ViewKey; label: string; view: View }[] = [
  ...weeks.map((w) => ({
    key: `w${w}`,
    label: `SEMAINE ${w}`,
    view: buildView(
      enrichedGames.filter((g) => g.week === w),
      stats.sessions.filter((s) => s.week === w),
    ),
  })),
  {
    key: "all",
    label: "GLOBAL",
    view: buildView(enrichedGames, stats.sessions),
  },
];
const activePeriod = `w${latestWeek}`;

const hideCss = periods
  .map(
    (p) =>
      `body[data-period="${p.key}"] [data-view]:not([data-view="${p.key}"]) { display: none; }\n` +
      `body[data-period="${p.key}"] [data-footer-period] [data-fp]:not([data-fp="${p.key}"]) { display: none; }`,
  )
  .join("\n");

const generatedAt = new Date(stats.generatedAt).toLocaleDateString("fr-FR");

const allView = periods.find((p) => p.key === "all")!.view;
const sortedAll = [...allView.games].sort((a, b) => Number(a.id) - Number(b.id));
const currentElo = sortedAll[sortedAll.length - 1]?.elo ?? 0;
const playerNames = Object.values(players).map((p) => p.name).join(" × ");
const ogTitle = "Road to Champion · JDay & Néma";
const ogDescription =
  `Stats GeoGuessr Duels du duo ${playerNames} (${duoRank}) — ${allView.kpis.games} parties, ` +
  `${allView.kpis.winRate}% de victoires, ELO ${currentElo}.`;
const siteOrigin = String(Astro.site ?? "").replace(/\/+$/, "");
const basePath = `/${import.meta.env.BASE_URL.replace(/^\/+|\/+$/g, "")}/`;
const baseUrl = `${siteOrigin}${basePath}`;
const ogImage = `${baseUrl}og.png`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.png`} />
    <title>{ogTitle}</title>
    <meta name="description" content={ogDescription} />
    <link rel="canonical" href={baseUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Road to Champion" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={baseUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Tableau de bord du duo ${playerNames}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&family=Geist:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-period={activePeriod}>
    <StickyHeader weeks={weeks} activeWeek={latestWeek} periods={periods} />
    <div class="app">
      <header class="header">
        <TeamCard players={players} duoRank={duoRank} />
        <PeriodToggle weeks={weeks} activeWeek={latestWeek} />
      </header>

      {periods.map(({ key, view: v }) => (
        <div data-view={key} class="view">
          <KpiRow {...v.kpis} />
          <BlockElo games={v.games} sessions={v.sessions} />
          <BlockPrecision games={v.games} sessions={v.sessions} aggregateBySession={key === "all"} />
          <BlockPays countryStats={v.countryStats} />
          <BlockRecords games={v.games} rounds={v.rounds} />
          <BlockSessions sessions={v.sessions} players={players} />
        </div>
      ))}

      <footer class="footer">
        <span>JDAY × NÉMA · DUO STATS</span>
        <span data-footer-period>
          {periods.map(({ key, label, view: v }) => (
            <span data-fp={key}>{label} · {v.games.length} PARTIES</span>
          ))}
        </span>
        <span class="foot-right">
          <span>MAJ {generatedAt}</span>
          <a
            class="gh"
            href="https://github.com/gpoussel/geoscore-jday-nema"
            target="_blank"
            rel="noreferrer"
            aria-label="Code source sur GitHub"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.2 1.77 1.2 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.74-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.2-3.09-.12-.3-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.03 11.03 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.06.75.81 1.2 1.83 1.2 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.78 1.05.78 2.12v3.14c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
            </svg>
          </a>
        </span>
      </footer>
    </div>
  </body>
</html>

<style is:global set:html={hideCss}></style>
